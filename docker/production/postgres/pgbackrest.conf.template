# Rendered at container start from the environment (render-pgbackrest.sh); never commit keys.
[global]
repo1-type=s3
repo1-s3-endpoint=${BACKUP_S3_ENDPOINT}
repo1-storage-port=${BACKUP_S3_PORT}
repo1-s3-region=${BACKUP_S3_REGION}
repo1-s3-bucket=${BACKUP_S3_BUCKET}
repo1-s3-key=${BACKUP_S3_ACCESS_KEY_ID}
repo1-s3-key-secret=${BACKUP_S3_SECRET_ACCESS_KEY}
repo1-s3-uri-style=${BACKUP_S3_URI_STYLE}
repo1-s3-verify-tls=${BACKUP_S3_VERIFY_TLS}
repo1-path=/pgbackrest/${BACKUP_STANZA_PATH}
# Client-side encryption: the storage provider only ever sees ciphertext.
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=${BACKUP_ENCRYPTION_PASSPHRASE}
# Retention: keep the last N full backups (and every diff/WAL needed to restore from them).
repo1-retention-full=${BACKUP_RETENTION_FULL}
repo1-retention-full-type=count
repo1-retention-diff=${BACKUP_RETENTION_DIFF}
compress-type=zst
compress-level=3
process-max=2
start-fast=y
archive-async=y
spool-path=/var/spool/pgbackrest
log-level-console=info
log-level-file=detail
log-path=/var/log/pgbackrest

[main]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-socket-path=/var/run/postgresql
# The cluster's superuser is POSTGRES_USER (there is no "postgres" role).
pg1-user=${POSTGRES_USER}
pg1-database=${POSTGRES_DB}
