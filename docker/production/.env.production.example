# Production settings for docker/production/compose.yml. Copy to .env.production on the
# server (chmod 600, never commit it) and replace EVERY value marked CHANGE_ME.
# docs/production/ENVIRONMENT_VARIABLES.md explains each variable.
# The API and worker refuse to start in production with development secrets, PayMongo test
# keys, mock payments/shipping/SMS, http:// public URLs or insecure cookies.

# ---- Release -------------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/neilfurry/ecommerce
# A release tag such as v1.0.0 or a commit SHA (never "latest").
IMAGE_TAG=CHANGE_ME_release_tag
NODE_ENV=production
API_REPLICAS=2
WORKER_REPLICAS=1

# ---- Domains and TLS -------------------------------------------------------------------------
STOREFRONT_DOMAIN=shop.example.ph
SELLER_DOMAIN=seller.example.ph
ADMIN_DOMAIN=admin.example.ph
API_DOMAIN=api.example.ph
GRAFANA_DOMAIN=grafana.example.ph
ACME_EMAIL=CHANGE_ME_ops@example.ph
# Production: the ACME email (Let's Encrypt). "internal" = self-signed (local/CI only).
TLS_MODE=CHANGE_ME_ops@example.ph
# A CDN in front of the server: its IP ranges (space separated). Without a CDN: private_ranges.
CDN_TRUSTED_PROXIES=private_ranges
# Extra origins the frontends may load images from or call (S3 public endpoint, Sentry ingest).
ASSET_ORIGINS=https://files.example.ph https://o0.ingest.sentry.io

# Public URLs (links in emails, provider callbacks). Must be https://.
STOREFRONT_URL=https://shop.example.ph
SELLER_PORTAL_URL=https://seller.example.ph
ADMIN_PORTAL_URL=https://admin.example.ph
API_PUBLIC_URL=https://api.example.ph

# ---- HTTP ----------------------------------------------------------------------------------
API_PORT=3000
# The edge proxy is one hop in front of the API (two with a CDN that the edge trusts).
TRUST_PROXY=1
# Same-origin: each frontend calls /api on its own domain, so no cross-origin access is needed.
CORS_ORIGINS=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
SWAGGER_ENABLED=false
COOKIE_SECURE=true
# Admin Console staff must turn on two-step verification (required in production).
STAFF_MFA_REQUIRED=true
COOKIE_DOMAIN=

# ---- Secrets (generate each with: openssl rand -base64 48) ------------------------------------
AUTH_JWT_SECRET=CHANGE_ME
AUTH_OTP_SECRET=CHANGE_ME
# Changing this later disables everyone's authenticator-app sign-in.
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME
# Encrypts sellers' bank account numbers. Losing it makes them unreadable: keep it in the vault.
FINANCE_ENCRYPTION_KEY=CHANGE_ME
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_CUSTOMER_SESSION_DAYS=30
AUTH_STAFF_SESSION_HOURS=12
AUTH_MAX_FAILED_SIGN_INS=5
AUTH_LOCKOUT_MINUTES=15
# Sign-in, sign-up and reset attempts per client address per minute (3 to 100). Raise it if
# many customers share one address (mobile-carrier NAT); lockout still protects accounts.
AUTH_SIGN_IN_LIMIT_PER_MINUTE=10

# ---- PostgreSQL ------------------------------------------------------------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=marketplace
DATABASE_URL=postgresql://marketplace:CHANGE_ME@postgres:5432/marketplace?schema=public&connection_limit=20

# ---- Redis -----------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=512mb
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ---- Object storage (S3-compatible; the bucket is private) --------------------------------------
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=CHANGE-ME-marketplace-uploads
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false
STORAGE_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=5242880
# Only with the optional self-hosted MinIO (compose profile "storage").
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---- Email (transactional) and SMS -------------------------------------------------------------
SMTP_HOST=CHANGE_ME_smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="Marketplace <no-reply@example.ph>"
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=CHANGE_ME
SEMAPHORE_SENDER_NAME=MARKETPLACE

# ---- Payments (PayMongo LIVE keys; test keys are refused in production) -------------------------
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=CHANGE_ME_sk_live_
PAYMONGO_WEBHOOK_SECRET=CHANGE_ME_whsk_
PAYMONGO_CHECKOUT_VERSION=v2
# PayMongo payouts to sellers (optional; without it payouts are recorded manually).
PAYMONGO_WALLET_ACCOUNT_NUMBER=
PAYMONGO_WALLET_ACCOUNT_NAME=
PAYMONGO_WALLET_BIC=PAEYPHM2XXX
# Staging only. Must stay false (or absent) in production.
ALLOW_TEST_PAYMENTS=false

# ---- Shipping ----------------------------------------------------------------------------------
# Admin-managed rate table; sellers book their courier and enter tracking numbers.
SHIPPING_PROVIDER=rate_table

# ---- Worker ------------------------------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
DEV_TOOLS_ENABLED=false

# ---- Error tracking (Sentry or self-hosted GlitchTip; leave empty to disable) ---------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---- Database backups (pgBackRest, encrypted, S3) -------------------------------------------------
# A bucket in a DIFFERENT account/region from the uploads bucket, with object lock or versioning.
BACKUP_S3_ENDPOINT=s3.ap-southeast-2.amazonaws.com
BACKUP_S3_REGION=ap-southeast-2
BACKUP_S3_PORT=443
BACKUP_S3_BUCKET=CHANGE-ME-marketplace-db-backups
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_S3_URI_STYLE=host
BACKUP_S3_VERIFY_TLS=y
BACKUP_STANZA_PATH=marketplace
# At least 32 characters. Without it the backups cannot be restored: keep it in the vault.
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME
# Keep 4 weekly full backups (28 days of point-in-time recovery) and 7 differentials.
BACKUP_RETENTION_FULL=4
BACKUP_RETENTION_DIFF=7
BACKUP_HOUR_UTC=17
BACKUP_FULL_WEEKDAY=7

# ---- Uploaded-files backup (compose profile "storage-backup") ---------------------------------------
OBJECT_BACKUP_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
OBJECT_BACKUP_REGION=ap-southeast-2
OBJECT_BACKUP_BUCKET=CHANGE-ME-marketplace-uploads-backup
OBJECT_BACKUP_ACCESS_KEY_ID=CHANGE_ME
OBJECT_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME
OBJECT_BACKUP_RETENTION_DAYS=90
OBJECT_BACKUP_HOUR_UTC=18

# ---- Monitoring ----------------------------------------------------------------------------------
PROMETHEUS_RETENTION=30d
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
ALERT_SMTP_HOST=CHANGE_ME_smtp.example.com:587
ALERT_SMTP_USER=CHANGE_ME
ALERT_SMTP_PASSWORD=CHANGE_ME
ALERT_EMAIL_FROM=alerts@example.ph
ALERT_EMAIL_TEAM=CHANGE_ME_team@example.ph
ALERT_EMAIL_ONCALL=CHANGE_ME_oncall@example.ph
ALERT_WEBHOOK_URL=
