// =============================================================================
// Marketplace database schema (PostgreSQL, Prisma 7)
// Conventions: docs/database/DATABASE_CONVENTIONS.md
//
//   Identifiers   UUID primary keys for business entities:
//                   id String @id @default(uuid(7)) @db.Uuid
//                 (UUIDv7 is time-ordered, which keeps B-tree indexes compact).
//                 Small reference tables may use a natural key (currencies.code).
//   Naming        Models PascalCase singular; tables snake_case plural (@@map);
//                 columns snake_case (@map); FK columns <entity>_id.
//   Timestamps    created_at / updated_at on every table, timestamptz(3), UTC.
//                 Soft-deletable records add deleted_at.
//   Enums         Prisma enum PascalCase, values UPPER_SNAKE_CASE,
//                 PostgreSQL type snake_case (@@map).
//   Status        Lifecycle columns are named `status` and use an enum named
//                 <Entity>Status; transitions are enforced in services.
//   Money         Decimal(19, 4) + currency CHAR(3) FK to currencies. Never Float.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "./src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Reference data
// -----------------------------------------------------------------------------

/// ISO 4217 currencies the platform can transact in. Monetary columns elsewhere
/// reference this table so an unsupported currency can never be stored.
model Currency {
  /// ISO 4217 alphabetic code, e.g. "PHP".
  code       String   @id @db.Char(3)
  name       String   @db.VarChar(64)
  symbol     String   @db.VarChar(8)
  /// Number of minor-unit digits, e.g. 2 for centavos.
  minorUnits Int      @map("minor_units") @db.SmallInt
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("currencies")
}

// -----------------------------------------------------------------------------
// File storage metadata (objects live in S3-compatible storage)
// -----------------------------------------------------------------------------

/// Lifecycle of a stored object.
enum FileStatus {
  /// Metadata reserved; upload not yet confirmed (direct-to-storage uploads).
  PENDING
  /// Object stored and downloadable.
  AVAILABLE
  /// Object removed from storage; row kept for audit.
  DELETED

  @@map("file_status")
}

/// Why a file exists. Each upload feature adds its own value (PRODUCT_IMAGE, SELLER_DOCUMENT...).
enum FilePurpose {
  /// Uploaded from the development tools page; never available in production.
  DEV_TEST
  /// Seller verification documents. Private: served only to the seller and to staff with
  /// sellers.read, through the API (never a public or pre-signed URL).
  SELLER_DOCUMENT
  /// Store logo and banner images. Public.
  STORE_LOGO
  STORE_BANNER
  /// Product photos (optimised WebP) and their thumbnails. Public.
  PRODUCT_IMAGE
  PRODUCT_IMAGE_THUMBNAIL
  /// Category images. Public.
  CATEGORY_IMAGE

  @@map("file_purpose")
}

/// Metadata for every object the platform stores. Object keys are generated by the
/// server (never derived from user file names).
model StoredFile {
  id             String      @id @default(uuid(7)) @db.Uuid
  bucket         String      @db.VarChar(63)
  objectKey      String      @map("object_key") @db.VarChar(512)
  /// File name as uploaded, for display and Content-Disposition only.
  originalName   String      @map("original_name") @db.VarChar(255)
  /// MIME type verified from the file's content, not trusted from the client.
  contentType    String      @map("content_type") @db.VarChar(127)
  sizeBytes      BigInt      @map("size_bytes")
  checksumSha256 String      @map("checksum_sha256") @db.Char(64)
  purpose        FilePurpose
  status         FileStatus  @default(AVAILABLE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  sellerDocument SellerDocument?
  storeLogo      Store?          @relation("StoreLogo")
  storeBanner    Store?          @relation("StoreBanner")
  categoryImage  Category?       @relation("CategoryImage")
  productImage   ProductImage?   @relation("ProductImageFile")
  productThumb   ProductImage?   @relation("ProductImageThumbnail")

  @@unique([bucket, objectKey])
  @@index([purpose, status, createdAt])
  @@map("stored_files")
}

// -----------------------------------------------------------------------------
// Identity and access (Phase 2)
// -----------------------------------------------------------------------------

enum UserStatus {
  /// Can sign in.
  ACTIVE
  /// Staff account created by an admin; becomes ACTIVE when the invitation is accepted.
  INVITED
  /// Blocked by an admin; all sessions revoked.
  SUSPENDED

  @@map("user_status")
}

/// Every person who signs in: customers, seller staff and platform staff.
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; unique across all users.
  email             String     @unique @db.VarChar(254)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// E.164, e.g. +639171234567. Required for customers (SMS sign-in), optional for staff.
  mobile            String?    @unique @db.VarChar(16)
  mobileVerifiedAt  DateTime?  @map("mobile_verified_at") @db.Timestamptz(3)
  /// Argon2id hash. Null until an invited staff member sets a password.
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  firstName         String     @map("first_name") @db.VarChar(80)
  lastName          String     @map("last_name") @db.VarChar(80)
  status            UserStatus @default(ACTIVE)
  failedSignInCount Int        @default(0) @map("failed_sign_in_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastSignInAt      DateTime?  @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                UserRoleAssignment[]
  sessions             Session[]
  otpChallenges        OtpChallenge[]
  verificationTokens   VerificationToken[]
  wholesaleApplication WholesaleApplication?  @relation("WholesaleApplicant")
  reviewedApplications WholesaleApplication[] @relation("WholesaleReviewer")
  auditLogs            AuditLog[]
  ownedSeller          Seller?                @relation("SellerOwner")
  reviewedSellers      Seller[]               @relation("SellerReviewer")
  sellerMembership     SellerMember?          @relation("SellerMemberUser")
  invitedSellerMembers SellerMember[]         @relation("SellerMemberInviter")
  sellerInvitations    SellerInvitation[]     @relation("SellerInvitationInviter")
  uploadedSellerDocs   SellerDocument[]
  sellerEvents         SellerEvent[]
  mfa                  UserMfa?
  mfaRecoveryCodes     MfaRecoveryCode[]
  reviewedBrands       Brand[]                @relation("BrandReviewer")
  reviewedProducts     Product[]              @relation("ProductReviewer")
  createdProducts      Product[]              @relation("ProductCreator")
  productEvents        ProductEvent[]         @relation("ProductEventActor")
  customerPrices       CustomerPrice[]        @relation("CustomerPrices")
  inventoryMovements   InventoryMovement[]    @relation("InventoryMovementActor")
  stockTransfers       StockTransfer[]        @relation("StockTransferCreator")

  @@index([status, createdAt])
  @@map("users")
}

/// The 14 platform roles (codes match USER_ROLES in @marketplace/shared-types).
model Role {
  code        String   @id @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String   @db.VarChar(255)
  /// Locked roles (SUPER_ADMIN) always hold every permission and cannot be edited.
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

/// Permission codes checked in code (PERMISSION_CATALOG in @marketplace/shared-types).
model Permission {
  code        String   @id @db.VarChar(80)
  /// "platform" or "seller": a role holds only permissions of its own scope.
  scope       String   @default("platform") @db.VarChar(20)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         RolePermission[]
  sellerMembers SellerMemberPermission[]

  @@map("permissions")
}

/// Which permissions each role holds. Editable by SUPER_ADMIN in the Admin Console.
model RolePermission {
  roleCode       String   @map("role_code") @db.VarChar(40)
  permissionCode String   @map("permission_code") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleCode, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

/// Roles held by a user.
model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  roleCode  String   @map("role_code") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, roleCode])
  @@index([roleCode])
  @@map("user_roles")
}

/// The frontend a session belongs to; each app has its own cookies and allowed roles.
enum ClientApp {
  STOREFRONT
  SELLER
  ADMIN

  @@map("client_app")
}

enum SessionRevokeReason {
  SIGNED_OUT
  /// Replaced by a newer refresh token (normal rotation).
  ROTATED
  /// A rotated refresh token was used again: the whole family is revoked.
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN_REVOKED
  USER_SUSPENDED
  /// Seller staff suspended or removed by their seller.
  SELLER_MEMBERSHIP_ENDED

  @@map("session_revoke_reason")
}

/// One row per refresh token. Rotation creates a new row in the same family and revokes
/// the previous one; presenting a revoked token revokes the whole family.
model Session {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  /// Shared by every rotation of one sign-in.
  familyId         String               @map("family_id") @db.Uuid
  app              ClientApp
  /// SHA-256 of the refresh token; the token itself is never stored.
  refreshTokenHash String               @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokedReason    SessionRevokeReason? @map("revoked_reason")
  replacedById     String?              @unique @map("replaced_by_id") @db.Uuid
  ipAddress        String?              @map("ip_address") @db.VarChar(45)
  userAgent        String?              @map("user_agent") @db.VarChar(512)
  lastUsedAt       DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces   Session? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

enum OtpPurpose {
  SIGN_UP
  SIGN_IN

  @@map("otp_purpose")
}

/// A one-time SMS code. Only an HMAC of the code is stored.
model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  purpose    OtpPurpose
  /// E.164 destination.
  mobile     String     @db.VarChar(16)
  /// Known account (sign-in). Null for sign-up, and for sign-in to an unknown number.
  userId     String?    @map("user_id") @db.Uuid
  codeHash   String     @map("code_hash") @db.Char(64)
  /// Pending sign-up details (names, email, password hash). Cleared when consumed.
  payload    Json?
  attempts   Int        @default(0)
  sendCount  Int        @default(1) @map("send_count")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  lastSentAt DateTime   @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  ipAddress  String?    @map("ip_address") @db.VarChar(45)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([mobile, createdAt])
  @@index([userId])
  @@map("otp_challenges")
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION

  @@map("verification_token_purpose")
}

/// Single-use links sent by email. Only a SHA-256 of the token is stored.
model VerificationToken {
  id         String                   @id @default(uuid(7)) @db.Uuid
  userId     String                   @map("user_id") @db.Uuid
  purpose    VerificationTokenPurpose
  tokenHash  String                   @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime                 @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?                @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

enum WholesaleApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("wholesale_application_status")
}

/// A customer's request for wholesale pricing. Approval grants the WHOLESALE_CUSTOMER role.
/// One per customer; a rejected application can be resubmitted (back to PENDING).
model WholesaleApplication {
  id              String                     @id @default(uuid(7)) @db.Uuid
  userId          String                     @unique @map("user_id") @db.Uuid
  businessName    String                     @map("business_name") @db.VarChar(160)
  /// Philippine TIN, digits only (9 + optional 3–5 branch digits).
  tin             String                     @db.VarChar(14)
  businessAddress String                     @map("business_address") @db.VarChar(500)
  status          WholesaleApplicationStatus @default(PENDING)
  reviewedById    String?                    @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  reviewNote      String?                    @map("review_note") @db.VarChar(500)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User  @relation("WholesaleApplicant", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewedBy User? @relation("WholesaleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([reviewedById])
  @@map("wholesale_applications")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

/// Append-only record of security-relevant and administrative actions. A database trigger
/// rejects UPDATE and DELETE, so entries cannot be altered after the fact (no updated_at).
model AuditLog {
  id         String       @id @default(uuid(7)) @db.Uuid
  /// Dotted action name, e.g. "auth.sign_in", "user.suspended".
  action     String       @db.VarChar(100)
  outcome    AuditOutcome
  actorId    String?      @map("actor_id") @db.Uuid
  entityType String?      @map("entity_type") @db.VarChar(60)
  entityId   String?      @map("entity_id") @db.VarChar(100)
  ipAddress  String?      @map("ip_address") @db.VarChar(45)
  userAgent  String?      @map("user_agent") @db.VarChar(512)
  requestId  String?      @map("request_id") @db.VarChar(128)
  /// Extra context. Never contains passwords, codes or tokens.
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Two-step verification (Phase 2, optional per account)
// -----------------------------------------------------------------------------

/// Authenticator-app (TOTP, RFC 6238) enrolment. A row with enabled_at null is an
/// unfinished set-up. The secret is encrypted with AES-256-GCM (AUTH_MFA_ENCRYPTION_KEY).
model UserMfa {
  userId              String    @id @map("user_id") @db.Uuid
  totpSecretEncrypted String    @map("totp_secret_encrypted") @db.VarChar(255)
  enabledAt           DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Last accepted 30-second time step; a code is never accepted twice.
  lastUsedStep        BigInt?   @map("last_used_step")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("user_mfa")
}

/// Single-use codes for when the authenticator is lost. Only SHA-256 hashes are stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// -----------------------------------------------------------------------------
// Sellers, verification, staff and stores (Phase 2)
// -----------------------------------------------------------------------------

enum SellerStatus {
  /// Registered; completing the profile and documents (or asked for more information).
  PENDING
  /// Submitted; waiting for an admin decision.
  UNDER_REVIEW
  /// Approved: may create stores and sell.
  VERIFIED
  /// Not approved; the seller may correct the details and submit again.
  REJECTED
  /// Blocked by an admin; stores are hidden and changes are refused.
  SUSPENDED
  /// Permanently closed.
  CLOSED

  @@map("seller_status")
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  CORPORATION
  ONE_PERSON_CORPORATION
  COOPERATIVE

  @@map("business_type")
}

/// A business that sells on the marketplace. Owned by one user (SELLER_OWNER).
model Seller {
  id                 String       @id @default(uuid(7)) @db.Uuid
  status             SellerStatus @default(PENDING)
  businessName       String       @map("business_name") @db.VarChar(160)
  businessType       BusinessType @map("business_type")
  ownerId            String       @unique @map("owner_id") @db.Uuid
  /// Business contact details (the owner's sign-in email can differ).
  email              String       @db.VarChar(254)
  /// E.164.
  mobile             String       @db.VarChar(16)
  addressLine1       String?      @map("address_line1") @db.VarChar(160)
  addressLine2       String?      @map("address_line2") @db.VarChar(160)
  barangay           String?      @db.VarChar(100)
  city               String?      @db.VarChar(100)
  province           String?      @db.VarChar(100)
  /// Philippine postal code, 4 digits.
  postalCode         String?      @map("postal_code") @db.VarChar(4)
  /// DTI, SEC or CDA registration number, depending on the business type.
  registrationNumber String?      @map("registration_number") @db.VarChar(40)
  /// BIR TIN, digits only (9 + optional 3–5 branch digits).
  tin                String?      @db.VarChar(14)
  vatRegistered      Boolean      @default(false) @map("vat_registered")
  /// The latest message for the seller: rejection reason, information requested or suspension reason.
  statusNote         String?      @map("status_note") @db.VarChar(1000)
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  reviewedById       String?      @map("reviewed_by_id") @db.Uuid
  verifiedAt         DateTime?    @map("verified_at") @db.Timestamptz(3)
  suspendedAt        DateTime?    @map("suspended_at") @db.Timestamptz(3)
  closedAt           DateTime?    @map("closed_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User               @relation("SellerOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  User?              @relation("SellerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  documents   SellerDocument[]
  events      SellerEvent[]
  members     SellerMember[]
  invitations SellerInvitation[]
  stores      Store[]

  requestedBrands    Brand[]
  products           Product[]
  productVariants    ProductVariant[]
  warehouses         Warehouse[]
  stockLevels        StockLevel[]
  inventoryMovements InventoryMovement[]
  stockTransfers     StockTransfer[]
  stockReservations  StockReservation[]

  @@index([status, submittedAt])
  @@index([reviewedById])
  @@map("sellers")
}

enum SellerDocumentType {
  BUSINESS_REGISTRATION
  BIR_REGISTRATION
  MAYORS_PERMIT
  OWNER_ID
  OTHER

  @@map("seller_document_type")
}

/// A verification document. The file itself is private (stored_files purpose SELLER_DOCUMENT).
model SellerDocument {
  id           String             @id @default(uuid(7)) @db.Uuid
  sellerId     String             @map("seller_id") @db.Uuid
  type         SellerDocumentType
  fileId       String             @unique @map("file_id") @db.Uuid
  description  String?            @db.VarChar(200)
  uploadedById String             @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  seller     Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sellerId, createdAt])
  @@index([uploadedById])
  @@map("seller_documents")
}

enum SellerEventType {
  REGISTERED
  SUBMITTED
  INFO_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
  CLOSED

  @@map("seller_event_type")
}

/// Verification and status history shown to the seller and to admins.
model SellerEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  sellerId   String          @map("seller_id") @db.Uuid
  type       SellerEventType
  fromStatus SellerStatus?   @map("from_status")
  toStatus   SellerStatus    @map("to_status")
  note       String?         @db.VarChar(1000)
  actorId    String?         @map("actor_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sellerId, createdAt])
  @@index([actorId])
  @@map("seller_events")
}

enum SellerMemberStatus {
  ACTIVE
  SUSPENDED

  @@map("seller_member_status")
}

/// A person working for a seller (the owner included). A user belongs to at most one
/// seller. Seller roles are in user_roles; extra seller permissions are in
/// seller_member_permissions. Removing an employee deletes the row (the audit log keeps it).
model SellerMember {
  id          String             @id @default(uuid(7)) @db.Uuid
  sellerId    String             @map("seller_id") @db.Uuid
  userId      String             @unique @map("user_id") @db.Uuid
  status      SellerMemberStatus @default(ACTIVE)
  invitedById String?            @map("invited_by_id") @db.Uuid
  joinedAt    DateTime           @default(now()) @map("joined_at") @db.Timestamptz(3)
  suspendedAt DateTime?          @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller      Seller                   @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User                     @relation("SellerMemberUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitedBy   User?                    @relation("SellerMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  permissions SellerMemberPermission[]

  @@index([sellerId, status])
  @@index([invitedById])
  @@map("seller_members")
}

/// Seller permissions granted to one employee on top of their roles.
model SellerMemberPermission {
  memberId       String   @map("member_id") @db.Uuid
  permissionCode String   @map("permission_code") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  member     SellerMember @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission   @relation(fields: [permissionCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([memberId, permissionCode])
  @@index([permissionCode])
  @@map("seller_member_permissions")
}

/// An emailed invitation to join a seller as an employee. Only a SHA-256 of the token is
/// stored. Issuing a new invitation to the same email revokes the open one.
model SellerInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  /// Lower-cased.
  email       String    @db.VarChar(254)
  roles       String[]  @db.VarChar(40)
  permissions String[]  @db.VarChar(80)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  invitedById String    @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitedBy User   @relation("SellerInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sellerId, email])
  @@index([invitedById])
  @@map("seller_invitations")
}

enum StoreStatus {
  /// Visible to shoppers.
  ACTIVE
  /// Hidden by the seller.
  INACTIVE
  /// Hidden by an admin; the seller cannot reopen it.
  SUSPENDED

  @@map("store_status")
}

/// A seller's storefront. Shown to shoppers only when ACTIVE and the seller is VERIFIED.
model Store {
  id           String      @id @default(uuid(7)) @db.Uuid
  sellerId     String      @map("seller_id") @db.Uuid
  name         String      @db.VarChar(120)
  /// URL name, unique across the marketplace: lowercase letters, digits and hyphens.
  slug         String      @unique @db.VarChar(60)
  description  String?     @db.VarChar(2000)
  logoFileId   String?     @unique @map("logo_file_id") @db.Uuid
  bannerFileId String?     @unique @map("banner_file_id") @db.Uuid
  email        String?     @db.VarChar(254)
  /// E.164.
  phone        String?     @db.VarChar(16)
  addressLine1 String?     @map("address_line1") @db.VarChar(160)
  addressLine2 String?     @map("address_line2") @db.VarChar(160)
  barangay     String?     @db.VarChar(100)
  city         String?     @db.VarChar(100)
  province     String?     @db.VarChar(100)
  postalCode   String?     @map("postal_code") @db.VarChar(4)
  /// { facebook, instagram, tiktok, youtube, website } as https URLs.
  socialLinks  Json        @default("{}") @map("social_links")
  status       StoreStatus @default(ACTIVE)
  statusNote   String?     @map("status_note") @db.VarChar(1000)
  /// Reserved for custom domains (a later phase); unique when set.
  customDomain String?     @unique @map("custom_domain") @db.VarChar(253)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller     Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  logoFile   StoredFile?    @relation("StoreLogo", fields: [logoFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bannerFile StoredFile?    @relation("StoreBanner", fields: [bannerFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  settings   StoreSettings?
  products   Product[]

  @@index([sellerId, createdAt])
  @@index([status])
  @@map("stores")
}

/// Store settings and branding (prepared for custom themes and domains).
model StoreSettings {
  storeId         String   @id @map("store_id") @db.Uuid
  /// #rrggbb.
  primaryColor    String   @default("#1d4ed8") @map("primary_color") @db.Char(7)
  accentColor     String?  @map("accent_color") @db.Char(7)
  announcement    String?  @db.VarChar(280)
  shippingPolicy  String?  @map("shipping_policy") @db.VarChar(5000)
  returnPolicy    String?  @map("return_policy") @db.VarChar(5000)
  /// Shown to shoppers while the seller is away (orders are paused in later phases).
  vacationMode    Boolean  @default(false) @map("vacation_mode")
  vacationMessage String?  @map("vacation_message") @db.VarChar(280)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("store_settings")
}

// -----------------------------------------------------------------------------
// Catalog (Phase 3): categories, brands, products, variants, images
// -----------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  /// Hidden from shoppers and not selectable for new products.
  INACTIVE

  @@map("category_status")
}

/// Global category tree (at most three levels), managed by marketplace staff only.
model Category {
  id          String         @id @default(uuid(7)) @db.Uuid
  parentId    String?        @map("parent_id") @db.Uuid
  name        String         @db.VarChar(100)
  /// Unique across the marketplace: lowercase letters, digits and hyphens.
  slug        String         @unique @db.VarChar(100)
  description String?        @db.VarChar(2000)
  imageFileId String?        @unique @map("image_file_id") @db.Uuid
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  /// 0 for top-level categories; a child is one deeper than its parent (max 2).
  depth       Int            @default(0) @db.SmallInt
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children   Category[]          @relation("CategoryTree")
  imageFile  StoredFile?         @relation("CategoryImage", fields: [imageFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attributes CategoryAttribute[]
  products   Product[]

  @@index([parentId, sortOrder])
  @@index([status])
  @@map("categories")
}

enum CategoryAttributeType {
  TEXT
  NUMBER
  BOOLEAN
  /// One of the attribute's options.
  SELECT

  @@map("category_attribute_type")
}

/// A product specification a category asks for (e.g. "Screen size" for Phones).
/// Products in a category, or in any of its subcategories, fill these in.
model CategoryAttribute {
  id         String                @id @default(uuid(7)) @db.Uuid
  categoryId String                @map("category_id") @db.Uuid
  /// Stable key used in product data, e.g. "screen_size".
  code       String                @db.VarChar(40)
  name       String                @db.VarChar(80)
  type       CategoryAttributeType
  /// Allowed values for SELECT attributes (array of strings).
  options    Json                  @default("[]")
  unit       String?               @db.VarChar(20)
  isRequired Boolean               @default(false) @map("is_required")
  sortOrder  Int                   @default(0) @map("sort_order")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, code])
  @@map("category_attributes")
}

enum BrandStatus {
  /// Requested by a seller, waiting for a marketplace decision.
  PENDING
  ACTIVE
  REJECTED
  /// Retired; existing products keep it, new products cannot choose it.
  INACTIVE

  @@map("brand_status")
}

/// Global brand list kept by marketplace staff. Sellers may request new brands.
model Brand {
  id                  String      @id @default(uuid(7)) @db.Uuid
  name                String      @db.VarChar(100)
  /// Unique; also prevents near-duplicate names ("Acme" and "ACME").
  slug                String      @unique @db.VarChar(100)
  description         String?     @db.VarChar(1000)
  status              BrandStatus @default(ACTIVE)
  requestedBySellerId String?     @map("requested_by_seller_id") @db.Uuid
  reviewNote          String?     @map("review_note") @db.VarChar(1000)
  reviewedById        String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  requestedBySeller Seller?   @relation(fields: [requestedBySellerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedBy        User?     @relation("BrandReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  products          Product[]

  @@index([status, name])
  @@index([requestedBySellerId])
  @@index([reviewedById])
  @@map("brands")
}

enum ProductStatus {
  /// Being prepared by the seller; never shown to shoppers.
  DRAFT
  /// Submitted (or changed after approval) and waiting for a marketplace decision.
  PENDING_APPROVAL
  /// Approved and visible to shoppers (when the seller is verified and the store open).
  ACTIVE
  /// Not approved; the seller can fix it and submit again.
  REJECTED
  /// Hidden by the seller, or taken down by the marketplace (moderated_at set).
  INACTIVE
  /// Retired by the seller; kept for order history.
  ARCHIVED

  @@map("product_status")
}

/// A seller's product. Prices, stock and options live on its variants (at least one).
model Product {
  id                        String        @id @default(uuid(7)) @db.Uuid
  sellerId                  String        @map("seller_id") @db.Uuid
  storeId                   String        @map("store_id") @db.Uuid
  categoryId                String        @map("category_id") @db.Uuid
  brandId                   String?       @map("brand_id") @db.Uuid
  name                      String        @db.VarChar(200)
  /// Unique within the store; used in the product's public link.
  slug                      String        @db.VarChar(220)
  description               String?       @db.VarChar(20000)
  /// Free-form specifications: [{ name, value }].
  specifications            Json          @default("[]")
  /// Values of the category's attributes: { [attributeCode]: string | number | boolean }.
  attributeValues           Json          @default("{}") @map("attribute_values")
  status                    ProductStatus @default(DRAFT)
  currency                  String        @default("PHP") @db.Char(3)
  /// Smallest quantity per order for every buyer.
  minOrderQuantity          Int           @default(1) @map("min_order_quantity")
  maxOrderQuantity          Int?          @map("max_order_quantity")
  /// Whether approved wholesale customers get the wholesale price tiers.
  wholesaleEnabled          Boolean       @default(false) @map("wholesale_enabled")
  /// Smallest quantity for wholesale tiers to apply.
  wholesaleMinOrderQuantity Int           @default(1) @map("wholesale_min_order_quantity")
  seoTitle                  String?       @map("seo_title") @db.VarChar(70)
  seoDescription            String?       @map("seo_description") @db.VarChar(160)
  seoKeywords               String?       @map("seo_keywords") @db.VarChar(255)
  submittedAt               DateTime?     @map("submitted_at") @db.Timestamptz(3)
  reviewedAt                DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  reviewedById              String?       @map("reviewed_by_id") @db.Uuid
  /// The latest decision note: rejection reason or take-down reason.
  reviewNote                String?       @map("review_note") @db.VarChar(1000)
  /// When the product was last approved.
  approvedAt                DateTime?     @map("approved_at") @db.Timestamptz(3)
  /// Set while the marketplace has taken the product down; the seller must edit and resubmit.
  moderatedAt               DateTime?     @map("moderated_at") @db.Timestamptz(3)
  archivedAt                DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdById               String        @map("created_by_id") @db.Uuid
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller         Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currencyRef    Currency         @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy     User?            @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy      User             @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options        ProductOption[]
  variants       ProductVariant[]
  images         ProductImage[]
  events         ProductEvent[]
  priceTiers     PriceTier[]
  customerPrices CustomerPrice[]

  @@unique([storeId, slug])
  @@index([sellerId, status, updatedAt])
  @@index([status, submittedAt])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([currency])
  @@index([reviewedById])
  @@index([createdById])
  @@map("products")
}

enum ProductEventType {
  CREATED
  SUBMITTED
  /// An approved product's content changed and it went back to review.
  CHANGED_AFTER_APPROVAL
  APPROVED
  REJECTED
  /// Hidden by the seller.
  DEACTIVATED
  /// Shown again by the seller.
  ACTIVATED
  /// Taken down by the marketplace.
  TAKEN_DOWN
  ARCHIVED
  RESTORED

  @@map("product_event_type")
}

/// Product review history, shown to the seller and to reviewers.
model ProductEvent {
  id         String           @id @default(uuid(7)) @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  type       ProductEventType
  fromStatus ProductStatus?   @map("from_status")
  toStatus   ProductStatus?   @map("to_status")
  note       String?          @db.VarChar(1000)
  actorId    String?          @map("actor_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor   User?   @relation("ProductEventActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, createdAt])
  @@index([actorId])
  @@map("product_events")
}

/// A variation axis of a product, e.g. Size or Color (at most 3 per product).
model ProductOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String   @db.VarChar(40)
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id        String   @id @default(uuid(7)) @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  value     String   @db.VarChar(60)
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

enum VariantStatus {
  ACTIVE
  /// Not sold (e.g. discontinued colour); kept for history.
  INACTIVE

  @@map("variant_status")
}

/// A sellable unit (SKU) of a product. A product without options has one variant.
model ProductVariant {
  id             String        @id @default(uuid(7)) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  /// Denormalised from the product so SKUs can be unique per seller.
  sellerId       String        @map("seller_id") @db.Uuid
  sku            String        @db.VarChar(64)
  barcode        String?       @db.VarChar(64)
  /// e.g. "Red / Large"; "Default" for a product without options.
  title          String        @db.VarChar(200)
  /// Sorted option value ids joined by ":" (empty for the default variant); one variant per combination.
  optionKey      String        @default("") @map("option_key") @db.VarChar(200)
  /// Retail price in the product's currency.
  regularPrice   Decimal       @map("regular_price") @db.Decimal(19, 4)
  /// Discounted retail price, applied between sale_starts_at and sale_ends_at (open-ended when null).
  salePrice      Decimal?      @map("sale_price") @db.Decimal(19, 4)
  saleStartsAt   DateTime?     @map("sale_starts_at") @db.Timestamptz(3)
  saleEndsAt     DateTime?     @map("sale_ends_at") @db.Timestamptz(3)
  /// When false the variant is always available (services, made to order).
  trackInventory Boolean       @default(true) @map("track_inventory")
  weightGrams    Int?          @map("weight_grams")
  lengthCm       Decimal?      @map("length_cm") @db.Decimal(8, 2)
  widthCm        Decimal?      @map("width_cm") @db.Decimal(8, 2)
  heightCm       Decimal?      @map("height_cm") @db.Decimal(8, 2)
  status         VariantStatus @default(ACTIVE)
  position       Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seller         Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  optionValues   VariantOptionValue[]
  images         ProductImage[]
  priceTiers     PriceTier[]
  customerPrices CustomerPrice[]
  stockLevels    StockLevel[]
  movements      InventoryMovement[]
  transferItems  StockTransferItem[]
  reservations   StockReservation[]

  @@unique([sellerId, sku])
  @@unique([productId, optionKey])
  @@index([productId, position])
  @@index([barcode])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

/// A product photo: an optimised large WebP and a thumbnail, generated on upload.
model ProductImage {
  id              String   @id @default(uuid(7)) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  /// Optional: the variant this photo shows (e.g. the red one).
  variantId       String?  @map("variant_id") @db.Uuid
  fileId          String   @unique @map("file_id") @db.Uuid
  thumbnailFileId String   @unique @map("thumbnail_file_id") @db.Uuid
  altText         String?  @map("alt_text") @db.VarChar(200)
  position        Int      @default(0)
  width           Int
  height          Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  file          StoredFile      @relation("ProductImageFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  thumbnailFile StoredFile      @relation("ProductImageThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}

// -----------------------------------------------------------------------------
// Pricing (Phase 3). Prices are always calculated by the server from these rules.
// -----------------------------------------------------------------------------

/// Wholesale price tier: the unit price from min_quantity units up, for approved wholesale
/// customers. variant_id null applies to every variant of the product; a variant's own
/// tiers take precedence. Effective between starts_at and ends_at (open-ended when null).
model PriceTier {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  minQuantity Int       @map("min_quantity")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(19, 4)
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId, variantId, minQuantity])
  @@index([variantId])
  @@map("price_tiers")
}

/// A price the seller agreed with one customer. Takes precedence over every other price.
model CustomerPrice {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  minQuantity Int       @default(1) @map("min_quantity")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(19, 4)
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  note        String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer User            @relation("CustomerPrices", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerId, productId])
  @@index([productId, variantId])
  @@index([variantId])
  @@map("customer_prices")
}

// -----------------------------------------------------------------------------
// Inventory (Phase 3): warehouses, stock levels, the movement ledger, transfers and
// reservations. Stock changes only through InventoryService, in transactions.
// -----------------------------------------------------------------------------

enum WarehouseStatus {
  ACTIVE
  /// No new stock movements; existing stock stays visible.
  INACTIVE

  @@map("warehouse_status")
}

model Warehouse {
  id           String          @id @default(uuid(7)) @db.Uuid
  sellerId     String          @map("seller_id") @db.Uuid
  name         String          @db.VarChar(100)
  /// Short code unique within the seller, e.g. "QC-1".
  code         String          @db.VarChar(20)
  addressLine1 String          @map("address_line1") @db.VarChar(160)
  addressLine2 String?         @map("address_line2") @db.VarChar(160)
  barangay     String?         @db.VarChar(100)
  city         String          @db.VarChar(100)
  province     String          @db.VarChar(100)
  postalCode   String?         @map("postal_code") @db.VarChar(4)
  contactName  String?         @map("contact_name") @db.VarChar(120)
  /// E.164.
  phone        String?         @db.VarChar(16)
  status       WarehouseStatus @default(ACTIVE)
  /// Where stock is reserved first. Exactly one per seller (kept by the service).
  isDefault    Boolean         @default(false) @map("is_default")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller        Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLevels   StockLevel[]
  movements     InventoryMovement[]
  transfersFrom StockTransfer[]     @relation("TransferFrom")
  transfersTo   StockTransfer[]     @relation("TransferTo")
  reservations  StockReservation[]

  @@unique([sellerId, code])
  @@index([sellerId, status])
  @@map("warehouses")
}

/// Stock of one variant in one warehouse. available = quantity_on_hand - reserved_quantity;
/// CHECK constraints keep every quantity non-negative and reserved <= on hand.
model StockLevel {
  id                 String    @id @default(uuid(7)) @db.Uuid
  sellerId           String    @map("seller_id") @db.Uuid
  warehouseId        String    @map("warehouse_id") @db.Uuid
  variantId          String    @map("variant_id") @db.Uuid
  /// Sellable units physically in the warehouse.
  quantityOnHand     Int       @default(0) @map("quantity_on_hand")
  /// Units held for checkouts and unfulfilled orders.
  reservedQuantity   Int       @default(0) @map("reserved_quantity")
  /// Damaged units kept apart (not sellable, not in on hand).
  damagedQuantity    Int       @default(0) @map("damaged_quantity")
  /// Notify the seller when available stock falls to this level (null: never).
  lowStockThreshold  Int?      @map("low_stock_threshold")
  /// Set when a low-stock notice is sent; cleared when stock rises above the threshold.
  lowStockNotifiedAt DateTime? @map("low_stock_notified_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller       Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements    InventoryMovement[]
  reservations StockReservation[]

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([sellerId, updatedAt])
  @@map("stock_levels")
}

enum InventoryMovementType {
  /// Goods received (purchase, production).
  STOCK_IN
  /// Goods removed for reasons other than a sale (sample, internal use).
  STOCK_OUT
  /// Correction after a count; either direction.
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  /// Sellable units found damaged: on hand down, damaged up.
  DAMAGED
  /// Damaged units disposed of.
  DAMAGED_WRITE_OFF
  /// Customer return put back into sellable stock.
  RETURN_RESTOCK
  /// Customer return that cannot be sold again.
  RETURN_DAMAGED
  /// Reserved units shipped for an order.
  SALE

  @@map("inventory_movement_type")
}

/// Append-only inventory ledger: one row per change to a stock level, with the result.
/// A trigger rejects UPDATE and DELETE.
model InventoryMovement {
  id             String                @id @default(uuid(7)) @db.Uuid
  sellerId       String                @map("seller_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  variantId      String                @map("variant_id") @db.Uuid
  stockLevelId   String                @map("stock_level_id") @db.Uuid
  type           InventoryMovementType
  /// Change to quantity_on_hand (negative when stock leaves).
  quantityChange Int                   @map("quantity_change")
  /// Change to damaged_quantity.
  damagedChange  Int                   @default(0) @map("damaged_change")
  onHandAfter    Int                   @map("on_hand_after")
  reservedAfter  Int                   @map("reserved_after")
  damagedAfter   Int                   @map("damaged_after")
  reason         String?               @db.VarChar(500)
  transferId     String?               @map("transfer_id") @db.Uuid
  reservationId  String?               @map("reservation_id") @db.Uuid
  actorId        String?               @map("actor_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  seller      Seller            @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLevel  StockLevel        @relation(fields: [stockLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transfer    StockTransfer?    @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation StockReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User?             @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sellerId, createdAt])
  @@index([stockLevelId, createdAt])
  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([transferId])
  @@index([reservationId])
  @@index([actorId])
  @@map("inventory_movements")
}

/// Stock moved between two of a seller's warehouses (completed in one transaction).
model StockTransfer {
  id              String   @id @default(uuid(7)) @db.Uuid
  sellerId        String   @map("seller_id") @db.Uuid
  fromWarehouseId String   @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String   @map("to_warehouse_id") @db.Uuid
  note            String?  @db.VarChar(500)
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  seller        Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy     User                @relation("StockTransferCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         StockTransferItem[]
  movements     InventoryMovement[]

  @@index([sellerId, createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdById])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(uuid(7)) @db.Uuid
  transferId String @map("transfer_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid
  quantity   Int

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([transferId, variantId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

enum StockReservationStatus {
  /// Holding stock until expires_at.
  ACTIVE
  /// Turned into a stock deduction (SALE movement) when the order was fulfilled.
  CONVERTED
  /// Given back before expiry (checkout cancelled, order cancelled).
  RELEASED
  /// Given back automatically after expires_at.
  EXPIRED

  @@map("stock_reservation_status")
}

/// Stock held for a checkout or order item. Raising reserved_quantity and creating the
/// reservation happen in one transaction, guarded so available stock never goes below zero.
model StockReservation {
  id                String                 @id @default(uuid(7)) @db.Uuid
  sellerId          String                 @map("seller_id") @db.Uuid
  variantId         String                 @map("variant_id") @db.Uuid
  warehouseId       String                 @map("warehouse_id") @db.Uuid
  stockLevelId      String                 @map("stock_level_id") @db.Uuid
  quantity          Int
  status            StockReservationStatus @default(ACTIVE)
  /// The checkout session (or other process) that holds the stock.
  checkoutReference String                 @map("checkout_reference") @db.VarChar(100)
  /// The order item, once the order exists (orders arrive in the next phase).
  orderItemId       String?                @map("order_item_id") @db.Uuid
  expiresAt         DateTime               @map("expires_at") @db.Timestamptz(3)
  releasedAt        DateTime?              @map("released_at") @db.Timestamptz(3)
  convertedAt       DateTime?              @map("converted_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller     Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse  Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLevel StockLevel          @relation(fields: [stockLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements  InventoryMovement[]

  @@index([status, expiresAt])
  @@index([checkoutReference])
  @@index([orderItemId])
  @@index([stockLevelId, status])
  @@index([sellerId, createdAt])
  @@index([variantId])
  @@index([warehouseId])
  @@map("stock_reservations")
}
