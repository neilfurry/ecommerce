// =============================================================================
// Marketplace database schema (PostgreSQL, Prisma 7)
// Conventions: docs/database/DATABASE_CONVENTIONS.md
//
//   Identifiers   UUID primary keys for business entities:
//                   id String @id @default(uuid(7)) @db.Uuid
//                 (UUIDv7 is time-ordered, which keeps B-tree indexes compact).
//                 Small reference tables may use a natural key (currencies.code).
//   Naming        Models PascalCase singular; tables snake_case plural (@@map);
//                 columns snake_case (@map); FK columns <entity>_id.
//   Timestamps    created_at / updated_at on every table, timestamptz(3), UTC.
//                 Soft-deletable records add deleted_at.
//   Enums         Prisma enum PascalCase, values UPPER_SNAKE_CASE,
//                 PostgreSQL type snake_case (@@map).
//   Status        Lifecycle columns are named `status` and use an enum named
//                 <Entity>Status; transitions are enforced in services.
//   Money         Decimal(19, 4) + currency CHAR(3) FK to currencies. Never Float.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "./src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Reference data
// -----------------------------------------------------------------------------

/// ISO 4217 currencies the platform can transact in. Monetary columns elsewhere
/// reference this table so an unsupported currency can never be stored.
model Currency {
  /// ISO 4217 alphabetic code, e.g. "PHP".
  code       String   @id @db.Char(3)
  name       String   @db.VarChar(64)
  symbol     String   @db.VarChar(8)
  /// Number of minor-unit digits, e.g. 2 for centavos.
  minorUnits Int      @map("minor_units") @db.SmallInt
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]
  orders   Order[]
  coupons  Coupon[]
  payments Payment[] @relation("PaymentCurrency")

  @@map("currencies")
}

// -----------------------------------------------------------------------------
// File storage metadata (objects live in S3-compatible storage)
// -----------------------------------------------------------------------------

/// Lifecycle of a stored object.
enum FileStatus {
  /// Metadata reserved; upload not yet confirmed (direct-to-storage uploads).
  PENDING
  /// Object stored and downloadable.
  AVAILABLE
  /// Object removed from storage; row kept for audit.
  DELETED

  @@map("file_status")
}

/// Why a file exists. Each upload feature adds its own value (PRODUCT_IMAGE, SELLER_DOCUMENT...).
enum FilePurpose {
  /// Uploaded from the development tools page; never available in production.
  DEV_TEST
  /// Seller verification documents. Private: served only to the seller and to staff with
  /// sellers.read, through the API (never a public or pre-signed URL).
  SELLER_DOCUMENT
  /// Store logo and banner images. Public.
  STORE_LOGO
  STORE_BANNER
  /// Product photos (optimised WebP) and their thumbnails. Public.
  PRODUCT_IMAGE
  PRODUCT_IMAGE_THUMBNAIL
  /// Category images. Public.
  CATEGORY_IMAGE
  /// Storefront banners (home page hero and promotions). Public.
  HOME_BANNER
  /// Bank transfer receipts uploaded by customers. Private: the customer and finance staff.
  PAYMENT_PROOF
  /// Photos supporting a return request. Private: the customer, the seller and staff.
  RETURN_IMAGE
  /// Shipping labels (waybills). Private: the seller and staff.
  WAYBILL

  @@map("file_purpose")
}

/// Metadata for every object the platform stores. Object keys are generated by the
/// server (never derived from user file names).
model StoredFile {
  id             String      @id @default(uuid(7)) @db.Uuid
  bucket         String      @db.VarChar(63)
  objectKey      String      @map("object_key") @db.VarChar(512)
  /// File name as uploaded, for display and Content-Disposition only.
  originalName   String      @map("original_name") @db.VarChar(255)
  /// MIME type verified from the file's content, not trusted from the client.
  contentType    String      @map("content_type") @db.VarChar(127)
  sizeBytes      BigInt      @map("size_bytes")
  checksumSha256 String      @map("checksum_sha256") @db.Char(64)
  purpose        FilePurpose
  status         FileStatus  @default(AVAILABLE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  sellerDocument SellerDocument?
  storeLogo      Store?             @relation("StoreLogo")
  storeBanner    Store?             @relation("StoreBanner")
  categoryImage  Category?          @relation("CategoryImage")
  productImage   ProductImage?      @relation("ProductImageFile")
  productThumb   ProductImage?      @relation("ProductImageThumbnail")
  homeBanner     HomeBanner?        @relation("HomeBannerImage")
  paymentProof   BankTransferProof? @relation("PaymentProofFile")
  returnImage    ReturnImage?       @relation("ReturnImageFile")
  waybill        Shipment?          @relation("ShipmentWaybill")

  @@unique([bucket, objectKey])
  @@index([purpose, status, createdAt])
  @@map("stored_files")
}

// -----------------------------------------------------------------------------
// Identity and access (Phase 2)
// -----------------------------------------------------------------------------

enum UserStatus {
  /// Can sign in.
  ACTIVE
  /// Staff account created by an admin; becomes ACTIVE when the invitation is accepted.
  INVITED
  /// Blocked by an admin; all sessions revoked.
  SUSPENDED

  @@map("user_status")
}

/// Every person who signs in: customers, seller staff and platform staff.
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; unique across all users.
  email             String     @unique @db.VarChar(254)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// E.164, e.g. +639171234567. Required for customers (SMS sign-in), optional for staff.
  mobile            String?    @unique @db.VarChar(16)
  mobileVerifiedAt  DateTime?  @map("mobile_verified_at") @db.Timestamptz(3)
  /// Argon2id hash. Null until an invited staff member sets a password.
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  firstName         String     @map("first_name") @db.VarChar(80)
  lastName          String     @map("last_name") @db.VarChar(80)
  status            UserStatus @default(ACTIVE)
  failedSignInCount Int        @default(0) @map("failed_sign_in_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastSignInAt      DateTime?  @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                UserRoleAssignment[]
  sessions             Session[]
  otpChallenges        OtpChallenge[]
  verificationTokens   VerificationToken[]
  wholesaleApplication WholesaleApplication?  @relation("WholesaleApplicant")
  reviewedApplications WholesaleApplication[] @relation("WholesaleReviewer")
  auditLogs            AuditLog[]
  ownedSeller          Seller?                @relation("SellerOwner")
  reviewedSellers      Seller[]               @relation("SellerReviewer")
  sellerMembership     SellerMember?          @relation("SellerMemberUser")
  invitedSellerMembers SellerMember[]         @relation("SellerMemberInviter")
  sellerInvitations    SellerInvitation[]     @relation("SellerInvitationInviter")
  uploadedSellerDocs   SellerDocument[]
  sellerEvents         SellerEvent[]
  mfa                  UserMfa?
  mfaRecoveryCodes     MfaRecoveryCode[]
  reviewedBrands       Brand[]                @relation("BrandReviewer")
  reviewedProducts     Product[]              @relation("ProductReviewer")
  createdProducts      Product[]              @relation("ProductCreator")
  productEvents        ProductEvent[]         @relation("ProductEventActor")
  customerPrices       CustomerPrice[]        @relation("CustomerPrices")
  inventoryMovements   InventoryMovement[]    @relation("InventoryMovementActor")
  stockTransfers       StockTransfer[]        @relation("StockTransferCreator")
  addresses            CustomerAddress[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  reviews              ProductReview[]        @relation("ReviewAuthor")
  moderatedReviews     ProductReview[]        @relation("ReviewModerator")
  orders               Order[]                @relation("OrderCustomer")
  cancelledOrders      Order[]                @relation("OrderCanceller")
  orderEvents          OrderEvent[]           @relation("OrderEventActor")
  couponRedemptions    CouponRedemption[]
  createdCoupons       Coupon[]               @relation("CouponCreator")
  createdBanners       HomeBanner[]           @relation("HomeBannerCreator")
  createdFlashSales    FlashSale[]            @relation("FlashSaleCreator")
  platformSettings     PlatformSetting[]
  reviewedPayments     Payment[]              @relation("PaymentReviewer")
  paymentEvents        PaymentEvent[]         @relation("PaymentEventActor")
  submittedProofs      BankTransferProof[]    @relation("ProofSubmitter")
  reviewedProofs       BankTransferProof[]    @relation("ProofReviewer")
  bookedShipments      Shipment[]             @relation("ShipmentBooker")
  shipmentEvents       ShipmentEvent[]        @relation("ShipmentEventActor")
  codRemittances       CodRemittance[]        @relation("RemittanceRecorder")
  cancellationRequests CancellationRequest[]  @relation("CancellationRequester")
  cancellationAnswers  CancellationRequest[]  @relation("CancellationResponder")
  orderNotes           OrderNote[]            @relation("OrderNoteAuthor")
  returnRequests       ReturnRequest[]        @relation("ReturnCustomer")
  decidedReturns       ReturnRequest[]        @relation("ReturnDecider")
  requestedRefunds     Refund[]               @relation("RefundRequester")
  processedRefunds     Refund[]               @relation("RefundProcessor")

  @@index([status, createdAt])
  @@map("users")
}

/// The 14 platform roles (codes match USER_ROLES in @marketplace/shared-types).
model Role {
  code        String   @id @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String   @db.VarChar(255)
  /// Locked roles (SUPER_ADMIN) always hold every permission and cannot be edited.
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

/// Permission codes checked in code (PERMISSION_CATALOG in @marketplace/shared-types).
model Permission {
  code        String   @id @db.VarChar(80)
  /// "platform" or "seller": a role holds only permissions of its own scope.
  scope       String   @default("platform") @db.VarChar(20)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         RolePermission[]
  sellerMembers SellerMemberPermission[]

  @@map("permissions")
}

/// Which permissions each role holds. Editable by SUPER_ADMIN in the Admin Console.
model RolePermission {
  roleCode       String   @map("role_code") @db.VarChar(40)
  permissionCode String   @map("permission_code") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleCode, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

/// Roles held by a user.
model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  roleCode  String   @map("role_code") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, roleCode])
  @@index([roleCode])
  @@map("user_roles")
}

/// The frontend a session belongs to; each app has its own cookies and allowed roles.
enum ClientApp {
  STOREFRONT
  SELLER
  ADMIN

  @@map("client_app")
}

enum SessionRevokeReason {
  SIGNED_OUT
  /// Replaced by a newer refresh token (normal rotation).
  ROTATED
  /// A rotated refresh token was used again: the whole family is revoked.
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN_REVOKED
  USER_SUSPENDED
  /// Seller staff suspended or removed by their seller.
  SELLER_MEMBERSHIP_ENDED

  @@map("session_revoke_reason")
}

/// One row per refresh token. Rotation creates a new row in the same family and revokes
/// the previous one; presenting a revoked token revokes the whole family.
model Session {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  /// Shared by every rotation of one sign-in.
  familyId         String               @map("family_id") @db.Uuid
  app              ClientApp
  /// SHA-256 of the refresh token; the token itself is never stored.
  refreshTokenHash String               @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokedReason    SessionRevokeReason? @map("revoked_reason")
  replacedById     String?              @unique @map("replaced_by_id") @db.Uuid
  ipAddress        String?              @map("ip_address") @db.VarChar(45)
  userAgent        String?              @map("user_agent") @db.VarChar(512)
  lastUsedAt       DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces   Session? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

enum OtpPurpose {
  SIGN_UP
  SIGN_IN

  @@map("otp_purpose")
}

/// A one-time SMS code. Only an HMAC of the code is stored.
model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  purpose    OtpPurpose
  /// E.164 destination.
  mobile     String     @db.VarChar(16)
  /// Known account (sign-in). Null for sign-up, and for sign-in to an unknown number.
  userId     String?    @map("user_id") @db.Uuid
  codeHash   String     @map("code_hash") @db.Char(64)
  /// Pending sign-up details (names, email, password hash). Cleared when consumed.
  payload    Json?
  attempts   Int        @default(0)
  sendCount  Int        @default(1) @map("send_count")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  lastSentAt DateTime   @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  ipAddress  String?    @map("ip_address") @db.VarChar(45)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([mobile, createdAt])
  @@index([userId])
  @@map("otp_challenges")
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION

  @@map("verification_token_purpose")
}

/// Single-use links sent by email. Only a SHA-256 of the token is stored.
model VerificationToken {
  id         String                   @id @default(uuid(7)) @db.Uuid
  userId     String                   @map("user_id") @db.Uuid
  purpose    VerificationTokenPurpose
  tokenHash  String                   @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime                 @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?                @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

enum WholesaleApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("wholesale_application_status")
}

/// A customer's request for wholesale pricing. Approval grants the WHOLESALE_CUSTOMER role.
/// One per customer; a rejected application can be resubmitted (back to PENDING).
model WholesaleApplication {
  id              String                     @id @default(uuid(7)) @db.Uuid
  userId          String                     @unique @map("user_id") @db.Uuid
  businessName    String                     @map("business_name") @db.VarChar(160)
  /// Philippine TIN, digits only (9 + optional 3–5 branch digits).
  tin             String                     @db.VarChar(14)
  businessAddress String                     @map("business_address") @db.VarChar(500)
  status          WholesaleApplicationStatus @default(PENDING)
  reviewedById    String?                    @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  reviewNote      String?                    @map("review_note") @db.VarChar(500)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User  @relation("WholesaleApplicant", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewedBy User? @relation("WholesaleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([reviewedById])
  @@map("wholesale_applications")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

/// Append-only record of security-relevant and administrative actions. A database trigger
/// rejects UPDATE and DELETE, so entries cannot be altered after the fact (no updated_at).
model AuditLog {
  id         String       @id @default(uuid(7)) @db.Uuid
  /// Dotted action name, e.g. "auth.sign_in", "user.suspended".
  action     String       @db.VarChar(100)
  outcome    AuditOutcome
  actorId    String?      @map("actor_id") @db.Uuid
  entityType String?      @map("entity_type") @db.VarChar(60)
  entityId   String?      @map("entity_id") @db.VarChar(100)
  ipAddress  String?      @map("ip_address") @db.VarChar(45)
  userAgent  String?      @map("user_agent") @db.VarChar(512)
  requestId  String?      @map("request_id") @db.VarChar(128)
  /// Extra context. Never contains passwords, codes or tokens.
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Two-step verification (Phase 2, optional per account)
// -----------------------------------------------------------------------------

/// Authenticator-app (TOTP, RFC 6238) enrolment. A row with enabled_at null is an
/// unfinished set-up. The secret is encrypted with AES-256-GCM (AUTH_MFA_ENCRYPTION_KEY).
model UserMfa {
  userId              String    @id @map("user_id") @db.Uuid
  totpSecretEncrypted String    @map("totp_secret_encrypted") @db.VarChar(255)
  enabledAt           DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Last accepted 30-second time step; a code is never accepted twice.
  lastUsedStep        BigInt?   @map("last_used_step")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("user_mfa")
}

/// Single-use codes for when the authenticator is lost. Only SHA-256 hashes are stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// -----------------------------------------------------------------------------
// Sellers, verification, staff and stores (Phase 2)
// -----------------------------------------------------------------------------

enum SellerStatus {
  /// Registered; completing the profile and documents (or asked for more information).
  PENDING
  /// Submitted; waiting for an admin decision.
  UNDER_REVIEW
  /// Approved: may create stores and sell.
  VERIFIED
  /// Not approved; the seller may correct the details and submit again.
  REJECTED
  /// Blocked by an admin; stores are hidden and changes are refused.
  SUSPENDED
  /// Permanently closed.
  CLOSED

  @@map("seller_status")
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  CORPORATION
  ONE_PERSON_CORPORATION
  COOPERATIVE

  @@map("business_type")
}

/// A business that sells on the marketplace. Owned by one user (SELLER_OWNER).
model Seller {
  id                 String       @id @default(uuid(7)) @db.Uuid
  status             SellerStatus @default(PENDING)
  businessName       String       @map("business_name") @db.VarChar(160)
  businessType       BusinessType @map("business_type")
  ownerId            String       @unique @map("owner_id") @db.Uuid
  /// Business contact details (the owner's sign-in email can differ).
  email              String       @db.VarChar(254)
  /// E.164.
  mobile             String       @db.VarChar(16)
  addressLine1       String?      @map("address_line1") @db.VarChar(160)
  addressLine2       String?      @map("address_line2") @db.VarChar(160)
  barangay           String?      @db.VarChar(100)
  city               String?      @db.VarChar(100)
  province           String?      @db.VarChar(100)
  /// Philippine postal code, 4 digits.
  postalCode         String?      @map("postal_code") @db.VarChar(4)
  /// DTI, SEC or CDA registration number, depending on the business type.
  registrationNumber String?      @map("registration_number") @db.VarChar(40)
  /// BIR TIN, digits only (9 + optional 3–5 branch digits).
  tin                String?      @db.VarChar(14)
  vatRegistered      Boolean      @default(false) @map("vat_registered")
  /// The latest message for the seller: rejection reason, information requested or suspension reason.
  statusNote         String?      @map("status_note") @db.VarChar(1000)
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  reviewedById       String?      @map("reviewed_by_id") @db.Uuid
  verifiedAt         DateTime?    @map("verified_at") @db.Timestamptz(3)
  suspendedAt        DateTime?    @map("suspended_at") @db.Timestamptz(3)
  closedAt           DateTime?    @map("closed_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User               @relation("SellerOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  User?              @relation("SellerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  documents   SellerDocument[]
  events      SellerEvent[]
  members     SellerMember[]
  invitations SellerInvitation[]
  stores      Store[]

  requestedBrands    Brand[]
  products           Product[]
  productVariants    ProductVariant[]
  warehouses         Warehouse[]
  stockLevels        StockLevel[]
  inventoryMovements InventoryMovement[]
  stockTransfers     StockTransfer[]
  stockReservations  StockReservation[]
  sellerOrders       SellerOrder[]
  coupons            Coupon[]
  flashSaleItems     FlashSaleItem[]
  reviews            ProductReview[]
  returnRequests     ReturnRequest[]     @relation("SellerReturns")
  ledgerEntries      SellerLedgerEntry[] @relation("SellerLedger")

  @@index([status, submittedAt])
  @@index([reviewedById])
  @@map("sellers")
}

enum SellerDocumentType {
  BUSINESS_REGISTRATION
  BIR_REGISTRATION
  MAYORS_PERMIT
  OWNER_ID
  OTHER

  @@map("seller_document_type")
}

/// A verification document. The file itself is private (stored_files purpose SELLER_DOCUMENT).
model SellerDocument {
  id           String             @id @default(uuid(7)) @db.Uuid
  sellerId     String             @map("seller_id") @db.Uuid
  type         SellerDocumentType
  fileId       String             @unique @map("file_id") @db.Uuid
  description  String?            @db.VarChar(200)
  uploadedById String             @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  seller     Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sellerId, createdAt])
  @@index([uploadedById])
  @@map("seller_documents")
}

enum SellerEventType {
  REGISTERED
  SUBMITTED
  INFO_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
  CLOSED

  @@map("seller_event_type")
}

/// Verification and status history shown to the seller and to admins.
model SellerEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  sellerId   String          @map("seller_id") @db.Uuid
  type       SellerEventType
  fromStatus SellerStatus?   @map("from_status")
  toStatus   SellerStatus    @map("to_status")
  note       String?         @db.VarChar(1000)
  actorId    String?         @map("actor_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sellerId, createdAt])
  @@index([actorId])
  @@map("seller_events")
}

enum SellerMemberStatus {
  ACTIVE
  SUSPENDED

  @@map("seller_member_status")
}

/// A person working for a seller (the owner included). A user belongs to at most one
/// seller. Seller roles are in user_roles; extra seller permissions are in
/// seller_member_permissions. Removing an employee deletes the row (the audit log keeps it).
model SellerMember {
  id          String             @id @default(uuid(7)) @db.Uuid
  sellerId    String             @map("seller_id") @db.Uuid
  userId      String             @unique @map("user_id") @db.Uuid
  status      SellerMemberStatus @default(ACTIVE)
  invitedById String?            @map("invited_by_id") @db.Uuid
  joinedAt    DateTime           @default(now()) @map("joined_at") @db.Timestamptz(3)
  suspendedAt DateTime?          @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller      Seller                   @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User                     @relation("SellerMemberUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitedBy   User?                    @relation("SellerMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  permissions SellerMemberPermission[]

  @@index([sellerId, status])
  @@index([invitedById])
  @@map("seller_members")
}

/// Seller permissions granted to one employee on top of their roles.
model SellerMemberPermission {
  memberId       String   @map("member_id") @db.Uuid
  permissionCode String   @map("permission_code") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  member     SellerMember @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission   @relation(fields: [permissionCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([memberId, permissionCode])
  @@index([permissionCode])
  @@map("seller_member_permissions")
}

/// An emailed invitation to join a seller as an employee. Only a SHA-256 of the token is
/// stored. Issuing a new invitation to the same email revokes the open one.
model SellerInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  /// Lower-cased.
  email       String    @db.VarChar(254)
  roles       String[]  @db.VarChar(40)
  permissions String[]  @db.VarChar(80)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  invitedById String    @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitedBy User   @relation("SellerInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sellerId, email])
  @@index([invitedById])
  @@map("seller_invitations")
}

enum StoreStatus {
  /// Visible to shoppers.
  ACTIVE
  /// Hidden by the seller.
  INACTIVE
  /// Hidden by an admin; the seller cannot reopen it.
  SUSPENDED

  @@map("store_status")
}

/// A seller's storefront. Shown to shoppers only when ACTIVE and the seller is VERIFIED.
model Store {
  id           String      @id @default(uuid(7)) @db.Uuid
  sellerId     String      @map("seller_id") @db.Uuid
  name         String      @db.VarChar(120)
  /// URL name, unique across the marketplace: lowercase letters, digits and hyphens.
  slug         String      @unique @db.VarChar(60)
  description  String?     @db.VarChar(2000)
  logoFileId   String?     @unique @map("logo_file_id") @db.Uuid
  bannerFileId String?     @unique @map("banner_file_id") @db.Uuid
  email        String?     @db.VarChar(254)
  /// E.164.
  phone        String?     @db.VarChar(16)
  addressLine1 String?     @map("address_line1") @db.VarChar(160)
  addressLine2 String?     @map("address_line2") @db.VarChar(160)
  barangay     String?     @db.VarChar(100)
  city         String?     @db.VarChar(100)
  province     String?     @db.VarChar(100)
  postalCode   String?     @map("postal_code") @db.VarChar(4)
  /// { facebook, instagram, tiktok, youtube, website } as https URLs.
  socialLinks  Json        @default("{}") @map("social_links")
  status       StoreStatus @default(ACTIVE)
  statusNote   String?     @map("status_note") @db.VarChar(1000)
  /// Reserved for custom domains (a later phase); unique when set.
  customDomain String?     @unique @map("custom_domain") @db.VarChar(253)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller     Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  logoFile   StoredFile?    @relation("StoreLogo", fields: [logoFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bannerFile StoredFile?    @relation("StoreBanner", fields: [bannerFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  settings   StoreSettings?
  products   Product[]
  featured   FeaturedStore?
  orders     SellerOrder[]

  @@index([sellerId, createdAt])
  @@index([status])
  @@map("stores")
}

/// Store settings and branding (prepared for custom themes and domains).
model StoreSettings {
  storeId         String   @id @map("store_id") @db.Uuid
  /// #rrggbb.
  primaryColor    String   @default("#1d4ed8") @map("primary_color") @db.Char(7)
  accentColor     String?  @map("accent_color") @db.Char(7)
  announcement    String?  @db.VarChar(280)
  shippingPolicy  String?  @map("shipping_policy") @db.VarChar(5000)
  returnPolicy    String?  @map("return_policy") @db.VarChar(5000)
  /// Shown to shoppers while the seller is away (orders are paused in later phases).
  vacationMode    Boolean  @default(false) @map("vacation_mode")
  vacationMessage String?  @map("vacation_message") @db.VarChar(280)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("store_settings")
}

// -----------------------------------------------------------------------------
// Catalog (Phase 3): categories, brands, products, variants, images
// -----------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  /// Hidden from shoppers and not selectable for new products.
  INACTIVE

  @@map("category_status")
}

/// Global category tree (at most three levels), managed by marketplace staff only.
model Category {
  id          String         @id @default(uuid(7)) @db.Uuid
  parentId    String?        @map("parent_id") @db.Uuid
  name        String         @db.VarChar(100)
  /// Unique across the marketplace: lowercase letters, digits and hyphens.
  slug        String         @unique @db.VarChar(100)
  description String?        @db.VarChar(2000)
  imageFileId String?        @unique @map("image_file_id") @db.Uuid
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  /// 0 for top-level categories; a child is one deeper than its parent (max 2).
  depth       Int            @default(0) @db.SmallInt
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children        Category[]          @relation("CategoryTree")
  imageFile       StoredFile?         @relation("CategoryImage", fields: [imageFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attributes      CategoryAttribute[]
  products        Product[]
  commissionRules CommissionRule[]

  @@index([parentId, sortOrder])
  @@index([status])
  @@map("categories")
}

enum CategoryAttributeType {
  TEXT
  NUMBER
  BOOLEAN
  /// One of the attribute's options.
  SELECT

  @@map("category_attribute_type")
}

/// A product specification a category asks for (e.g. "Screen size" for Phones).
/// Products in a category, or in any of its subcategories, fill these in.
model CategoryAttribute {
  id         String                @id @default(uuid(7)) @db.Uuid
  categoryId String                @map("category_id") @db.Uuid
  /// Stable key used in product data, e.g. "screen_size".
  code       String                @db.VarChar(40)
  name       String                @db.VarChar(80)
  type       CategoryAttributeType
  /// Allowed values for SELECT attributes (array of strings).
  options    Json                  @default("[]")
  unit       String?               @db.VarChar(20)
  isRequired Boolean               @default(false) @map("is_required")
  sortOrder  Int                   @default(0) @map("sort_order")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, code])
  @@map("category_attributes")
}

enum BrandStatus {
  /// Requested by a seller, waiting for a marketplace decision.
  PENDING
  ACTIVE
  REJECTED
  /// Retired; existing products keep it, new products cannot choose it.
  INACTIVE

  @@map("brand_status")
}

/// Global brand list kept by marketplace staff. Sellers may request new brands.
model Brand {
  id                  String      @id @default(uuid(7)) @db.Uuid
  name                String      @db.VarChar(100)
  /// Unique; also prevents near-duplicate names ("Acme" and "ACME").
  slug                String      @unique @db.VarChar(100)
  description         String?     @db.VarChar(1000)
  status              BrandStatus @default(ACTIVE)
  requestedBySellerId String?     @map("requested_by_seller_id") @db.Uuid
  reviewNote          String?     @map("review_note") @db.VarChar(1000)
  reviewedById        String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  requestedBySeller Seller?   @relation(fields: [requestedBySellerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedBy        User?     @relation("BrandReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  products          Product[]

  @@index([status, name])
  @@index([requestedBySellerId])
  @@index([reviewedById])
  @@map("brands")
}

enum ProductStatus {
  /// Being prepared by the seller; never shown to shoppers.
  DRAFT
  /// Submitted (or changed after approval) and waiting for a marketplace decision.
  PENDING_APPROVAL
  /// Approved and visible to shoppers (when the seller is verified and the store open).
  ACTIVE
  /// Not approved; the seller can fix it and submit again.
  REJECTED
  /// Hidden by the seller, or taken down by the marketplace (moderated_at set).
  INACTIVE
  /// Retired by the seller; kept for order history.
  ARCHIVED

  @@map("product_status")
}

/// A seller's product. Prices, stock and options live on its variants (at least one).
model Product {
  id                        String        @id @default(uuid(7)) @db.Uuid
  sellerId                  String        @map("seller_id") @db.Uuid
  storeId                   String        @map("store_id") @db.Uuid
  categoryId                String        @map("category_id") @db.Uuid
  brandId                   String?       @map("brand_id") @db.Uuid
  name                      String        @db.VarChar(200)
  /// Unique within the store; used in the product's public link.
  slug                      String        @db.VarChar(220)
  description               String?       @db.VarChar(20000)
  /// Free-form specifications: [{ name, value }].
  specifications            Json          @default("[]")
  /// Values of the category's attributes: { [attributeCode]: string | number | boolean }.
  attributeValues           Json          @default("{}") @map("attribute_values")
  status                    ProductStatus @default(DRAFT)
  currency                  String        @default("PHP") @db.Char(3)
  /// Smallest quantity per order for every buyer.
  minOrderQuantity          Int           @default(1) @map("min_order_quantity")
  maxOrderQuantity          Int?          @map("max_order_quantity")
  /// Whether approved wholesale customers get the wholesale price tiers.
  wholesaleEnabled          Boolean       @default(false) @map("wholesale_enabled")
  /// Smallest quantity for wholesale tiers to apply.
  wholesaleMinOrderQuantity Int           @default(1) @map("wholesale_min_order_quantity")
  seoTitle                  String?       @map("seo_title") @db.VarChar(70)
  seoDescription            String?       @map("seo_description") @db.VarChar(160)
  seoKeywords               String?       @map("seo_keywords") @db.VarChar(255)
  submittedAt               DateTime?     @map("submitted_at") @db.Timestamptz(3)
  reviewedAt                DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  reviewedById              String?       @map("reviewed_by_id") @db.Uuid
  /// The latest decision note: rejection reason or take-down reason.
  reviewNote                String?       @map("review_note") @db.VarChar(1000)
  /// When the product was last approved.
  approvedAt                DateTime?     @map("approved_at") @db.Timestamptz(3)
  /// Set while the marketplace has taken the product down; the seller must edit and resubmit.
  moderatedAt               DateTime?     @map("moderated_at") @db.Timestamptz(3)
  archivedAt                DateTime?     @map("archived_at") @db.Timestamptz(3)
  /// Average of published review ratings (0 when there are none), kept with the reviews.
  ratingAverage             Decimal       @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount               Int           @default(0) @map("rating_count")
  /// Units sold in placed orders (cancelled orders are subtracted); for "best sellers".
  soldCount                 Int           @default(0) @map("sold_count")
  createdById               String        @map("created_by_id") @db.Uuid
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller         Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currencyRef    Currency         @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy     User?            @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy      User             @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options        ProductOption[]
  variants       ProductVariant[]
  images         ProductImage[]
  events         ProductEvent[]
  priceTiers     PriceTier[]
  customerPrices CustomerPrice[]
  wishlistItems  WishlistItem[]
  reviews        ProductReview[]
  featured       FeaturedProduct?
  flashSaleItems FlashSaleItem[]
  orderItems     OrderItem[]

  @@unique([storeId, slug])
  @@index([sellerId, status, updatedAt])
  @@index([status, submittedAt])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([currency])
  @@index([reviewedById])
  @@index([status, soldCount])
  @@index([status, ratingAverage])
  @@index([createdById])
  @@map("products")
}

enum ProductEventType {
  CREATED
  SUBMITTED
  /// An approved product's content changed and it went back to review.
  CHANGED_AFTER_APPROVAL
  APPROVED
  REJECTED
  /// Hidden by the seller.
  DEACTIVATED
  /// Shown again by the seller.
  ACTIVATED
  /// Taken down by the marketplace.
  TAKEN_DOWN
  ARCHIVED
  RESTORED

  @@map("product_event_type")
}

/// Product review history, shown to the seller and to reviewers.
model ProductEvent {
  id         String           @id @default(uuid(7)) @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  type       ProductEventType
  fromStatus ProductStatus?   @map("from_status")
  toStatus   ProductStatus?   @map("to_status")
  note       String?          @db.VarChar(1000)
  actorId    String?          @map("actor_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor   User?   @relation("ProductEventActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, createdAt])
  @@index([actorId])
  @@map("product_events")
}

/// A variation axis of a product, e.g. Size or Color (at most 3 per product).
model ProductOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String   @db.VarChar(40)
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id        String   @id @default(uuid(7)) @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  value     String   @db.VarChar(60)
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

enum VariantStatus {
  ACTIVE
  /// Not sold (e.g. discontinued colour); kept for history.
  INACTIVE

  @@map("variant_status")
}

/// A sellable unit (SKU) of a product. A product without options has one variant.
model ProductVariant {
  id             String        @id @default(uuid(7)) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  /// Denormalised from the product so SKUs can be unique per seller.
  sellerId       String        @map("seller_id") @db.Uuid
  sku            String        @db.VarChar(64)
  barcode        String?       @db.VarChar(64)
  /// e.g. "Red / Large"; "Default" for a product without options.
  title          String        @db.VarChar(200)
  /// Sorted option value ids joined by ":" (empty for the default variant); one variant per combination.
  optionKey      String        @default("") @map("option_key") @db.VarChar(200)
  /// Retail price in the product's currency.
  regularPrice   Decimal       @map("regular_price") @db.Decimal(19, 4)
  /// Discounted retail price, applied between sale_starts_at and sale_ends_at (open-ended when null).
  salePrice      Decimal?      @map("sale_price") @db.Decimal(19, 4)
  saleStartsAt   DateTime?     @map("sale_starts_at") @db.Timestamptz(3)
  saleEndsAt     DateTime?     @map("sale_ends_at") @db.Timestamptz(3)
  /// When false the variant is always available (services, made to order).
  trackInventory Boolean       @default(true) @map("track_inventory")
  weightGrams    Int?          @map("weight_grams")
  lengthCm       Decimal?      @map("length_cm") @db.Decimal(8, 2)
  widthCm        Decimal?      @map("width_cm") @db.Decimal(8, 2)
  heightCm       Decimal?      @map("height_cm") @db.Decimal(8, 2)
  status         VariantStatus @default(ACTIVE)
  position       Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seller         Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  optionValues   VariantOptionValue[]
  images         ProductImage[]
  priceTiers     PriceTier[]
  customerPrices CustomerPrice[]
  stockLevels    StockLevel[]
  movements      InventoryMovement[]
  transferItems  StockTransferItem[]
  reservations   StockReservation[]
  cartItems      CartItem[]
  flashSaleItems FlashSaleItem[]
  orderItems     OrderItem[]

  @@unique([sellerId, sku])
  @@unique([productId, optionKey])
  @@index([productId, position])
  @@index([barcode])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

/// A product photo: an optimised large WebP and a thumbnail, generated on upload.
model ProductImage {
  id              String   @id @default(uuid(7)) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  /// Optional: the variant this photo shows (e.g. the red one).
  variantId       String?  @map("variant_id") @db.Uuid
  fileId          String   @unique @map("file_id") @db.Uuid
  thumbnailFileId String   @unique @map("thumbnail_file_id") @db.Uuid
  altText         String?  @map("alt_text") @db.VarChar(200)
  position        Int      @default(0)
  width           Int
  height          Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  file          StoredFile      @relation("ProductImageFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  thumbnailFile StoredFile      @relation("ProductImageThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}

// -----------------------------------------------------------------------------
// Pricing (Phase 3). Prices are always calculated by the server from these rules.
// -----------------------------------------------------------------------------

/// Wholesale price tier: the unit price from min_quantity units up, for approved wholesale
/// customers. variant_id null applies to every variant of the product; a variant's own
/// tiers take precedence. Effective between starts_at and ends_at (open-ended when null).
model PriceTier {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  minQuantity Int       @map("min_quantity")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(19, 4)
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId, variantId, minQuantity])
  @@index([variantId])
  @@map("price_tiers")
}

/// A price the seller agreed with one customer. Takes precedence over every other price.
model CustomerPrice {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  minQuantity Int       @default(1) @map("min_quantity")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(19, 4)
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  note        String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer User            @relation("CustomerPrices", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([customerId, productId])
  @@index([productId, variantId])
  @@index([variantId])
  @@map("customer_prices")
}

// -----------------------------------------------------------------------------
// Inventory (Phase 3): warehouses, stock levels, the movement ledger, transfers and
// reservations. Stock changes only through InventoryService, in transactions.
// -----------------------------------------------------------------------------

enum WarehouseStatus {
  ACTIVE
  /// No new stock movements; existing stock stays visible.
  INACTIVE

  @@map("warehouse_status")
}

model Warehouse {
  id           String          @id @default(uuid(7)) @db.Uuid
  sellerId     String          @map("seller_id") @db.Uuid
  name         String          @db.VarChar(100)
  /// Short code unique within the seller, e.g. "QC-1".
  code         String          @db.VarChar(20)
  addressLine1 String          @map("address_line1") @db.VarChar(160)
  addressLine2 String?         @map("address_line2") @db.VarChar(160)
  barangay     String?         @db.VarChar(100)
  city         String          @db.VarChar(100)
  province     String          @db.VarChar(100)
  postalCode   String?         @map("postal_code") @db.VarChar(4)
  /// PSGC codes of the address (shipping origin); the text fields above are kept for display.
  regionCode   String?         @map("region_code") @db.Char(10)
  provinceCode String?         @map("province_code") @db.Char(10)
  cityCode     String?         @map("city_code") @db.Char(10)
  barangayCode String?         @map("barangay_code") @db.Char(10)
  contactName  String?         @map("contact_name") @db.VarChar(120)
  /// E.164.
  phone        String?         @db.VarChar(16)
  status       WarehouseStatus @default(ACTIVE)
  /// Where stock is reserved first. Exactly one per seller (kept by the service).
  isDefault    Boolean         @default(false) @map("is_default")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller           Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLevels      StockLevel[]
  movements        InventoryMovement[]
  transfersFrom    StockTransfer[]      @relation("TransferFrom")
  transfersTo      StockTransfer[]      @relation("TransferTo")
  reservations     StockReservation[]
  regionLocation   PhLocation?          @relation("WarehouseRegion", fields: [regionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  provinceLocation PhLocation?          @relation("WarehouseProvince", fields: [provinceCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  cityLocation     PhLocation?          @relation("WarehouseCity", fields: [cityCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  barangayLocation PhLocation?          @relation("WarehouseBarangay", fields: [barangayCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  shippingGroups   OrderShippingGroup[]

  @@unique([sellerId, code])
  @@index([sellerId, status])
  @@index([regionCode])
  @@index([provinceCode])
  @@index([cityCode])
  @@index([barangayCode])
  @@map("warehouses")
}

/// Stock of one variant in one warehouse. available = quantity_on_hand - reserved_quantity;
/// CHECK constraints keep every quantity non-negative and reserved <= on hand.
model StockLevel {
  id                 String    @id @default(uuid(7)) @db.Uuid
  sellerId           String    @map("seller_id") @db.Uuid
  warehouseId        String    @map("warehouse_id") @db.Uuid
  variantId          String    @map("variant_id") @db.Uuid
  /// Sellable units physically in the warehouse.
  quantityOnHand     Int       @default(0) @map("quantity_on_hand")
  /// Units held for checkouts and unfulfilled orders.
  reservedQuantity   Int       @default(0) @map("reserved_quantity")
  /// Damaged units kept apart (not sellable, not in on hand).
  damagedQuantity    Int       @default(0) @map("damaged_quantity")
  /// Notify the seller when available stock falls to this level (null: never).
  lowStockThreshold  Int?      @map("low_stock_threshold")
  /// Set when a low-stock notice is sent; cleared when stock rises above the threshold.
  lowStockNotifiedAt DateTime? @map("low_stock_notified_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller       Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements    InventoryMovement[]
  reservations StockReservation[]

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([sellerId, updatedAt])
  @@map("stock_levels")
}

enum InventoryMovementType {
  /// Goods received (purchase, production).
  STOCK_IN
  /// Goods removed for reasons other than a sale (sample, internal use).
  STOCK_OUT
  /// Correction after a count; either direction.
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  /// Sellable units found damaged: on hand down, damaged up.
  DAMAGED
  /// Damaged units disposed of.
  DAMAGED_WRITE_OFF
  /// Customer return put back into sellable stock.
  RETURN_RESTOCK
  /// Customer return that cannot be sold again.
  RETURN_DAMAGED
  /// Reserved units shipped for an order.
  SALE

  @@map("inventory_movement_type")
}

/// Append-only inventory ledger: one row per change to a stock level, with the result.
/// A trigger rejects UPDATE and DELETE.
model InventoryMovement {
  id             String                @id @default(uuid(7)) @db.Uuid
  sellerId       String                @map("seller_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  variantId      String                @map("variant_id") @db.Uuid
  stockLevelId   String                @map("stock_level_id") @db.Uuid
  type           InventoryMovementType
  /// Change to quantity_on_hand (negative when stock leaves).
  quantityChange Int                   @map("quantity_change")
  /// Change to damaged_quantity.
  damagedChange  Int                   @default(0) @map("damaged_change")
  onHandAfter    Int                   @map("on_hand_after")
  reservedAfter  Int                   @map("reserved_after")
  damagedAfter   Int                   @map("damaged_after")
  reason         String?               @db.VarChar(500)
  transferId     String?               @map("transfer_id") @db.Uuid
  reservationId  String?               @map("reservation_id") @db.Uuid
  actorId        String?               @map("actor_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  seller      Seller            @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLevel  StockLevel        @relation(fields: [stockLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transfer    StockTransfer?    @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation StockReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User?             @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sellerId, createdAt])
  @@index([stockLevelId, createdAt])
  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([transferId])
  @@index([reservationId])
  @@index([actorId])
  @@map("inventory_movements")
}

/// Stock moved between two of a seller's warehouses (completed in one transaction).
model StockTransfer {
  id              String   @id @default(uuid(7)) @db.Uuid
  sellerId        String   @map("seller_id") @db.Uuid
  fromWarehouseId String   @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String   @map("to_warehouse_id") @db.Uuid
  note            String?  @db.VarChar(500)
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  seller        Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy     User                @relation("StockTransferCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         StockTransferItem[]
  movements     InventoryMovement[]

  @@index([sellerId, createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdById])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(uuid(7)) @db.Uuid
  transferId String @map("transfer_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid
  quantity   Int

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([transferId, variantId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

enum StockReservationStatus {
  /// Holding stock until expires_at (or, for a placed order, until fulfilment or cancellation).
  ACTIVE
  /// Turned into a stock deduction (SALE movement) when the order was fulfilled.
  CONVERTED
  /// Given back before expiry (checkout cancelled, order cancelled).
  RELEASED
  /// Given back automatically after expires_at.
  EXPIRED

  @@map("stock_reservation_status")
}

/// Stock held for a checkout or order item. Raising reserved_quantity and creating the
/// reservation happen in one transaction, guarded so available stock never goes below zero.
model StockReservation {
  id                String                 @id @default(uuid(7)) @db.Uuid
  sellerId          String                 @map("seller_id") @db.Uuid
  variantId         String                 @map("variant_id") @db.Uuid
  warehouseId       String                 @map("warehouse_id") @db.Uuid
  stockLevelId      String                 @map("stock_level_id") @db.Uuid
  quantity          Int
  status            StockReservationStatus @default(ACTIVE)
  /// The checkout session (or other process) that holds the stock.
  checkoutReference String                 @map("checkout_reference") @db.VarChar(100)
  /// The order item, once the order exists.
  orderItemId       String?                @map("order_item_id") @db.Uuid
  /// Null only for holds of placed orders, which last until fulfilment or cancellation.
  expiresAt         DateTime?              @map("expires_at") @db.Timestamptz(3)
  releasedAt        DateTime?              @map("released_at") @db.Timestamptz(3)
  convertedAt       DateTime?              @map("converted_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller     Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse  Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockLevel StockLevel          @relation(fields: [stockLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItem  OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements  InventoryMovement[]

  @@index([status, expiresAt])
  @@index([checkoutReference])
  @@index([orderItemId])
  @@index([stockLevelId, status])
  @@index([sellerId, createdAt])
  @@index([variantId])
  @@index([warehouseId])
  @@map("stock_reservations")
}

// -----------------------------------------------------------------------------
// Storefront, cart and checkout (Phase 4)
// -----------------------------------------------------------------------------

/// Levels of the Philippine Standard Geographic Code (PSGC).
enum LocationLevel {
  REGION
  PROVINCE
  CITY
  MUNICIPALITY
  /// Sub-municipality (the districts of the City of Manila).
  SUB_MUNICIPALITY
  BARANGAY

  @@map("location_level")
}

/// Philippine regions, provinces, cities/municipalities and barangays, imported from the PSA's
/// PSGC publication (`pnpm db:import-locations`). Configurable data, not code: a newer
/// publication is imported the same way, and locations can be switched off.
model PhLocation {
  /// 10-digit PSGC code.
  code         String        @id @db.Char(10)
  name         String        @db.VarChar(150)
  level        LocationLevel
  parentCode   String?       @map("parent_code") @db.Char(10)
  regionCode   String        @map("region_code") @db.Char(10)
  /// Null in the National Capital Region, which has no provinces.
  provinceCode String?       @map("province_code") @db.Char(10)
  /// The city or municipality a barangay (or Manila district) belongs to.
  cityCode     String?       @map("city_code") @db.Char(10)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent             PhLocation?       @relation("LocationTree", fields: [parentCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  children           PhLocation[]      @relation("LocationTree")
  addressRegions     CustomerAddress[] @relation("AddressRegion")
  addressProvinces   CustomerAddress[] @relation("AddressProvince")
  addressCities      CustomerAddress[] @relation("AddressCity")
  addressBarangays   CustomerAddress[] @relation("AddressBarangay")
  warehouseRegions   Warehouse[]       @relation("WarehouseRegion")
  warehouseProvinces Warehouse[]       @relation("WarehouseProvince")
  warehouseCities    Warehouse[]       @relation("WarehouseCity")
  warehouseBarangays Warehouse[]       @relation("WarehouseBarangay")

  @@index([parentCode, name])
  @@index([level, name])
  @@index([cityCode, level])
  @@map("ph_locations")
}

/// A customer's saved delivery address. Orders copy the address, so editing or deleting one
/// never changes an order.
model CustomerAddress {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  /// e.g. "Home", "Office".
  label         String?  @db.VarChar(40)
  recipientName String   @map("recipient_name") @db.VarChar(120)
  /// E.164.
  mobile        String   @db.VarChar(16)
  regionCode    String   @map("region_code") @db.Char(10)
  provinceCode  String?  @map("province_code") @db.Char(10)
  cityCode      String   @map("city_code") @db.Char(10)
  barangayCode  String   @map("barangay_code") @db.Char(10)
  postalCode    String   @map("postal_code") @db.VarChar(4)
  /// House or unit number and street.
  streetAddress String   @map("street_address") @db.VarChar(200)
  /// Building, floor, subdivision or landmark (optional).
  addressLine2  String?  @map("address_line2") @db.VarChar(200)
  /// One default per customer (partial unique index).
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  region   PhLocation  @relation("AddressRegion", fields: [regionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  province PhLocation? @relation("AddressProvince", fields: [provinceCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  city     PhLocation  @relation("AddressCity", fields: [cityCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  barangay PhLocation  @relation("AddressBarangay", fields: [barangayCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  orders   Order[]

  @@index([userId, createdAt])
  @@index([regionCode])
  @@index([provinceCode])
  @@index([cityCode])
  @@index([barangayCode])
  @@map("customer_addresses")
}

/// A line in a signed-in customer's cart (or saved for later). Prices are never stored as
/// the truth: the cart is re-priced by the server every time it is read.
model CartItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  savedForLater Boolean  @default(false) @map("saved_for_later")
  /// The unit price the customer last saw, to point out price changes.
  lastSeenPrice Decimal? @map("last_seen_price") @db.Decimal(19, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

enum ReviewStatus {
  PUBLISHED
  /// Hidden by the marketplace (moderation); not counted in the rating.
  HIDDEN

  @@map("review_status")
}

/// A rating and review for a product the customer bought: one per order item.
model ProductReview {
  id             String       @id @default(uuid(7)) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  sellerId       String       @map("seller_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  orderItemId    String       @unique @map("order_item_id") @db.Uuid
  rating         Int          @db.SmallInt
  title          String?      @db.VarChar(120)
  body           String?      @db.VarChar(4000)
  status         ReviewStatus @default(PUBLISHED)
  moderationNote String?      @map("moderation_note") @db.VarChar(500)
  moderatedById  String?      @map("moderated_by_id") @db.Uuid
  moderatedAt    DateTime?    @map("moderated_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User      @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moderatedBy User?     @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([moderatedById])
  @@map("product_reviews")
}

// ---- Storefront content -------------------------------------------------------------

enum PromotionStatus {
  ACTIVE
  INACTIVE

  @@map("promotion_status")
}

enum BannerPlacement {
  /// The large rotating banner at the top of the home page.
  HERO
  /// Smaller promotional banners further down.
  PROMO

  @@map("banner_placement")
}

model HomeBanner {
  id          String          @id @default(uuid(7)) @db.Uuid
  title       String          @db.VarChar(120)
  subtitle    String?         @db.VarChar(200)
  imageFileId String          @unique @map("image_file_id") @db.Uuid
  /// A path inside the storefront, e.g. "/c/rice-and-grains" or "/search?q=rice".
  linkUrl     String?         @map("link_url") @db.VarChar(300)
  placement   BannerPlacement @default(HERO)
  position    Int             @default(0)
  status      PromotionStatus @default(ACTIVE)
  startsAt    DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?       @map("ends_at") @db.Timestamptz(3)
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  imageFile StoredFile @relation("HomeBannerImage", fields: [imageFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User       @relation("HomeBannerCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([placement, status, position])
  @@index([createdById])
  @@map("home_banners")
}

/// Products picked by the marketplace for the home page.
model FeaturedProduct {
  id        String    @id @default(uuid(7)) @db.Uuid
  productId String    @unique @map("product_id") @db.Uuid
  position  Int       @default(0)
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([position])
  @@map("featured_products")
}

/// Stores picked by the marketplace for the home page.
model FeaturedStore {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   String   @unique @map("store_id") @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([position])
  @@map("featured_stores")
}

/// A time-limited marketplace campaign; sellers add their own variants at a flash price.
model FlashSale {
  id          String          @id @default(uuid(7)) @db.Uuid
  title       String          @db.VarChar(120)
  startsAt    DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime        @map("ends_at") @db.Timestamptz(3)
  status      PromotionStatus @default(ACTIVE)
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User            @relation("FlashSaleCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items     FlashSaleItem[]

  @@index([status, startsAt, endsAt])
  @@index([createdById])
  @@map("flash_sales")
}

/// A variant offered in a flash sale. sold_quantity is raised by checkout with a guarded
/// update, so the flash price never sells more than quantity_limit units.
model FlashSaleItem {
  id            String          @id @default(uuid(7)) @db.Uuid
  flashSaleId   String          @map("flash_sale_id") @db.Uuid
  sellerId      String          @map("seller_id") @db.Uuid
  productId     String          @map("product_id") @db.Uuid
  variantId     String          @map("variant_id") @db.Uuid
  flashPrice    Decimal         @map("flash_price") @db.Decimal(19, 4)
  quantityLimit Int             @map("quantity_limit")
  soldQuantity  Int             @default(0) @map("sold_quantity")
  /// Most units one order may buy at the flash price.
  perOrderLimit Int?            @map("per_order_limit")
  status        PromotionStatus @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  flashSale  FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seller     Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItems OrderItem[]

  @@unique([flashSaleId, variantId])
  @@index([sellerId, createdAt])
  @@index([productId])
  @@index([variantId, status])
  @@map("flash_sale_items")
}

// ---- Coupons --------------------------------------------------------------------------

enum CouponScope {
  /// Created by the marketplace, applies to the whole order, paid by the marketplace.
  PLATFORM
  /// Created by a seller, applies to that seller's items, paid by the seller.
  SELLER

  @@map("coupon_scope")
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING

  @@map("coupon_type")
}

model Coupon {
  id               String          @id @default(uuid(7)) @db.Uuid
  /// Upper-case letters and digits; unique across the marketplace.
  code             String          @unique @db.VarChar(30)
  scope            CouponScope
  /// Set for seller coupons.
  sellerId         String?         @map("seller_id") @db.Uuid
  name             String          @db.VarChar(120)
  description      String?         @db.VarChar(500)
  type             CouponType
  /// Percent (1–100) for PERCENTAGE; pesos for FIXED_AMOUNT; unused (0) for FREE_SHIPPING.
  value            Decimal         @db.Decimal(19, 4)
  /// Cap on the discount (percentages and free shipping).
  maxDiscount      Decimal?        @map("max_discount") @db.Decimal(19, 4)
  /// Merchandise subtotal needed (the order for platform coupons, the seller's items otherwise).
  minSpend         Decimal         @default(0) @map("min_spend") @db.Decimal(19, 4)
  currency         String          @default("PHP") @db.Char(3)
  startsAt         DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime        @map("ends_at") @db.Timestamptz(3)
  /// Total redemptions allowed (null: unlimited).
  usageLimit       Int?            @map("usage_limit")
  perCustomerLimit Int             @default(1) @map("per_customer_limit")
  /// Redemptions by orders that are not cancelled; raised with a guarded update at checkout.
  usedCount        Int             @default(0) @map("used_count")
  status           PromotionStatus @default(ACTIVE)
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller       Seller?            @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currencyRef  Currency           @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User               @relation("CouponCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  redemptions  CouponRedemption[]
  orderCoupons OrderCoupon[]

  @@index([scope, status, endsAt])
  @@index([sellerId, createdAt])
  @@index([currency])
  @@index([createdById])
  @@map("coupons")
}

/// One use of a coupon by an order. Released (and used_count lowered) when the order is cancelled.
model CouponRedemption {
  id         String    @id @default(uuid(7)) @db.Uuid
  couponId   String    @map("coupon_id") @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  amount     Decimal   @db.Decimal(19, 4)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([orderId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ---- Configuration ----------------------------------------------------------------------

/// Typed settings edited by administrators (checkout charges and VAT, shipping rates).
/// Each key's value is validated by the API before it is stored.
model PlatformSetting {
  key         String   @id @db.VarChar(60)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([updatedById])
  @@map("platform_settings")
}

/// Marketplace commission rate: the default (no category) or for a category and its
/// subcategories. Order items keep the rule and rate used (the finance phase settles them).
model CommissionRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null: the default rate (exactly one, partial unique index).
  categoryId  String?  @unique @map("category_id") @db.Uuid
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItems OrderItem[]

  @@map("commission_rules")
}

// ---- Orders ------------------------------------------------------------------------------

enum OrderStatus {
  /// Paid online methods: stock is held until the payment deadline.
  AWAITING_PAYMENT
  /// Placed (cash on delivery, or paid); the sellers fulfil their suborders.
  PLACED
  /// Every seller order reached an end state, at least one of them completed.
  COMPLETED
  CANCELLED

  @@map("order_status")
}

/// Seller order life cycle; transitions are validated by the order state machine.
enum SellerOrderStatus {
  AWAITING_PAYMENT
  /// New: waiting for the seller to accept it.
  PENDING
  /// Accepted; being packed.
  PROCESSING
  /// Parcel booked with the courier; waiting for pickup.
  READY_FOR_PICKUP
  /// With the courier.
  SHIPPED
  /// A delivery attempt failed; the courier tries again or returns the parcel.
  DELIVERY_FAILED
  /// The parcel is on its way back to the seller.
  RETURNING_TO_SELLER
  RETURNED_TO_SELLER
  DELIVERED
  /// Delivered and the return window has passed (or the customer confirmed).
  COMPLETED
  CANCELLED

  @@map("seller_order_status")
}

enum PaymentMethod {
  COD
  GCASH
  MAYA
  CARD
  QR_PH
  BANK_TRANSFER

  @@map("payment_method")
}

/// The order's payment summary (each attempt is a row in payments).
enum PaymentStatus {
  /// Waiting for an online payment or a bank transfer.
  PENDING
  /// Cash on delivery: not financially collected until the courier's remittance is confirmed.
  PAY_ON_DELIVERY
  /// Some seller orders' cash-on-delivery amounts were remitted, others not yet.
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  /// Cancelled before anything was paid.
  VOIDED

  @@map("payment_status")
}

enum BuyerType {
  RETAIL
  WHOLESALE

  @@map("buyer_type")
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  SAME_DAY

  @@map("shipping_method")
}

enum OrderEventType {
  PLACED
  AWAITING_PAYMENT
  CANCELLED_BY_CUSTOMER
  PAYMENT_EXPIRED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  /// A seller order moved between statuses (from_status, to_status).
  STATUS_CHANGED
  CANCELLED_BY_SELLER
  CANCELLED_BY_STAFF
  CANCELLATION_REQUESTED
  CANCELLATION_APPROVED
  CANCELLATION_REJECTED
  SHIPMENT_CREATED
  SHIPMENT_UPDATED
  COD_COLLECTED
  COD_REMITTED
  RETURN_REQUESTED
  RETURN_UPDATED
  REFUND_CREATED
  REFUND_SUCCEEDED
  REFUND_FAILED
  NOTE_ADDED
  PAYMENT_PROOF_SUBMITTED
  PAYMENT_PROOF_REJECTED

  @@map("order_event_type")
}

/// The customer's order: one checkout, paid once, split into one suborder per seller.
/// Every amount is calculated by the server's checkout pricing service.
model Order {
  id               String        @id @default(uuid(7)) @db.Uuid
  /// e.g. "MP2611250001AB"; shown to customers.
  orderNumber      String        @unique @map("order_number") @db.VarChar(20)
  customerId       String        @map("customer_id") @db.Uuid
  status           OrderStatus
  paymentMethod    PaymentMethod @map("payment_method")
  paymentStatus    PaymentStatus @map("payment_status")
  buyerType        BuyerType     @map("buyer_type")
  currency         String        @default("PHP") @db.Char(3)
  /// Sent by the client once per checkout attempt, so a retried request never places two orders.
  idempotencyKey   String        @map("idempotency_key") @db.VarChar(100)
  addressId        String?       @map("address_id") @db.Uuid
  /// Copy of the delivery address and recipient at the time of the order.
  shippingAddress  Json          @map("shipping_address")
  contactEmail     String        @map("contact_email") @db.VarChar(254)
  /// Sum of item lines at the applied prices (after wholesale and flash prices).
  itemsSubtotal    Decimal       @map("items_subtotal") @db.Decimal(19, 4)
  /// What wholesale prices saved compared with retail (already in items_subtotal).
  wholesaleSavings Decimal       @map("wholesale_savings") @db.Decimal(19, 4)
  /// Coupon discounts on items (marketplace and seller coupons).
  couponDiscount   Decimal       @map("coupon_discount") @db.Decimal(19, 4)
  shippingFee      Decimal       @map("shipping_fee") @db.Decimal(19, 4)
  shippingDiscount Decimal       @map("shipping_discount") @db.Decimal(19, 4)
  /// Other configured charges (e.g. a cash-on-delivery fee).
  chargesTotal     Decimal       @map("charges_total") @db.Decimal(19, 4)
  /// VAT included in the total (prices include VAT).
  vatAmount        Decimal       @map("vat_amount") @db.Decimal(19, 4)
  grandTotal       Decimal       @map("grand_total") @db.Decimal(19, 4)
  /// The full breakdown returned by the checkout quote, including the settings used.
  pricingSnapshot  Json          @map("pricing_snapshot")
  /// Pay by this time (awaiting payment only); the order is cancelled afterwards.
  paymentDueAt     DateTime?     @map("payment_due_at") @db.Timestamptz(3)
  placedAt         DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason     String?       @map("cancel_reason") @db.VarChar(500)
  cancelledById    String?       @map("cancelled_by_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     User               @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cancelledBy  User?              @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  address      CustomerAddress?   @relation(fields: [addressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currencyRef  Currency           @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  sellerOrders SellerOrder[]
  items        OrderItem[]
  coupons      OrderCoupon[]
  redemptions  CouponRedemption[]
  events       OrderEvent[]
  payments     Payment[]
  notes        OrderNote[]
  returns      ReturnRequest[]
  refunds      Refund[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([status, paymentDueAt])
  @@index([addressId])
  @@index([cancelledById])
  @@index([currency])
  @@map("orders")
}

/// One seller's part of an order, with its own items, discounts, shipping, VAT and
/// commission reference. Sellers see and fulfil only their suborders.
model SellerOrder {
  id                       String            @id @default(uuid(7)) @db.Uuid
  orderId                  String            @map("order_id") @db.Uuid
  sellerId                 String            @map("seller_id") @db.Uuid
  storeId                  String            @map("store_id") @db.Uuid
  /// The order number with a suffix, e.g. "MP2611250001AB-1".
  number                   String            @unique @db.VarChar(24)
  status                   SellerOrderStatus
  itemsSubtotal            Decimal           @map("items_subtotal") @db.Decimal(19, 4)
  wholesaleSavings         Decimal           @map("wholesale_savings") @db.Decimal(19, 4)
  /// This seller's coupon (paid by the seller).
  sellerDiscount           Decimal           @map("seller_discount") @db.Decimal(19, 4)
  /// This suborder's share of the marketplace coupon (paid by the marketplace).
  platformDiscount         Decimal           @map("platform_discount") @db.Decimal(19, 4)
  shippingFee              Decimal           @map("shipping_fee") @db.Decimal(19, 4)
  sellerShippingDiscount   Decimal           @map("seller_shipping_discount") @db.Decimal(19, 4)
  platformShippingDiscount Decimal           @map("platform_shipping_discount") @db.Decimal(19, 4)
  chargesTotal             Decimal           @map("charges_total") @db.Decimal(19, 4)
  vatAmount                Decimal           @map("vat_amount") @db.Decimal(19, 4)
  total                    Decimal           @db.Decimal(19, 4)
  /// Sum of the items' commission amounts (calculated, settled in the finance phase).
  commissionAmount         Decimal           @map("commission_amount") @db.Decimal(19, 4)
  /// Applied charges: [{ code, label, amount }].
  charges                  Json              @default("[]")
  customerNote             String?           @map("customer_note") @db.VarChar(500)
  acceptedAt               DateTime?         @map("accepted_at") @db.Timestamptz(3)
  shippedAt                DateTime?         @map("shipped_at") @db.Timestamptz(3)
  deliveredAt              DateTime?         @map("delivered_at") @db.Timestamptz(3)
  completedAt              DateTime?         @map("completed_at") @db.Timestamptz(3)
  /// Customers may ask for a return until then (delivered_at plus the return window).
  returnWindowEndsAt       DateTime?         @map("return_window_ends_at") @db.Timestamptz(3)
  cancelReason             String?           @map("cancel_reason") @db.VarChar(500)
  cancelledAt              DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  seller        Seller                @relation(fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         OrderItem[]
  shippingGroup OrderShippingGroup?
  coupons       OrderCoupon[]
  events        OrderEvent[]
  shipments     Shipment[]
  codCollection CodCollection?
  notes         OrderNote[]
  cancellations CancellationRequest[]
  returns       ReturnRequest[]
  refunds       Refund[]
  ledgerEntries SellerLedgerEntry[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([storeId])
  @@map("seller_orders")
}

/// How one seller's parcel travels: origin warehouse, destination, weight and dimensions,
/// method and the fee quoted by the shipping provider.
model OrderShippingGroup {
  id                    String         @id @default(uuid(7)) @db.Uuid
  sellerOrderId         String         @unique @map("seller_order_id") @db.Uuid
  warehouseId           String?        @map("warehouse_id") @db.Uuid
  method                ShippingMethod
  provider              String         @db.VarChar(40)
  serviceName           String         @map("service_name") @db.VarChar(80)
  origin                Json
  destination           Json
  /// Actual weight of the items.
  weightGrams           Int            @map("weight_grams")
  /// The weight the fee is based on: the larger of actual and volumetric weight.
  chargeableWeightGrams Int            @map("chargeable_weight_grams")
  /// Estimated parcel size: [{ lengthCm, widthCm, heightCm, weightGrams }].
  parcels               Json
  fee                   Decimal        @db.Decimal(19, 4)
  discount              Decimal        @db.Decimal(19, 4)
  etaMinDays            Int            @map("eta_min_days")
  etaMaxDays            Int            @map("eta_max_days")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  warehouse   Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([warehouseId])
  @@map("order_shipping_groups")
}

/// A product line with everything copied at the time of the order: names, options, prices,
/// the pricing rule, discount shares, VAT and the commission reference.
model OrderItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  sellerOrderId    String   @map("seller_order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  flashSaleItemId  String?  @map("flash_sale_item_id") @db.Uuid
  sku              String   @db.VarChar(64)
  productName      String   @map("product_name") @db.VarChar(200)
  variantTitle     String   @map("variant_title") @db.VarChar(200)
  /// { "Size": "Large", ... }
  options          Json     @default("{}")
  /// Thumbnail at the time of the order (path of the public image URL).
  imageUrl         String?  @map("image_url") @db.VarChar(300)
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(19, 4)
  /// Retail list price per unit, for showing savings.
  regularUnitPrice Decimal  @map("regular_unit_price") @db.Decimal(19, 4)
  lineSubtotal     Decimal  @map("line_subtotal") @db.Decimal(19, 4)
  sellerDiscount   Decimal  @map("seller_discount") @db.Decimal(19, 4)
  platformDiscount Decimal  @map("platform_discount") @db.Decimal(19, 4)
  /// line_subtotal minus discounts.
  lineTotal        Decimal  @map("line_total") @db.Decimal(19, 4)
  vatAmount        Decimal  @map("vat_amount") @db.Decimal(19, 4)
  /// The price engine's line: source, rule, tiers.
  pricingSnapshot  Json     @map("pricing_snapshot")
  commissionRuleId String?  @map("commission_rule_id") @db.Uuid
  commissionRate   Decimal  @map("commission_rate") @db.Decimal(5, 2)
  /// What the commission is calculated on: line subtotal minus the seller-paid discount.
  commissionBase   Decimal  @map("commission_base") @db.Decimal(19, 4)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(19, 4)
  weightGrams      Int?     @map("weight_grams")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerOrder    SellerOrder        @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant        ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  flashSaleItem  FlashSaleItem?     @relation(fields: [flashSaleItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  commissionRule CommissionRule?    @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reservations   StockReservation[]
  review         ProductReview?
  returnItems    ReturnItem[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([productId, createdAt])
  @@index([variantId])
  @@index([flashSaleItemId])
  @@index([commissionRuleId])
  @@map("order_items")
}

/// A coupon applied to an order (seller coupons also point at their suborder).
model OrderCoupon {
  id            String      @id @default(uuid(7)) @db.Uuid
  orderId       String      @map("order_id") @db.Uuid
  sellerOrderId String?     @map("seller_order_id") @db.Uuid
  couponId      String      @map("coupon_id") @db.Uuid
  code          String      @db.VarChar(30)
  scope         CouponScope
  type          CouponType
  /// Item discount plus shipping discount given by this coupon.
  amount        Decimal     @db.Decimal(19, 4)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  coupon      Coupon       @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([couponId])
  @@map("order_coupons")
}

model OrderEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  orderId       String             @map("order_id") @db.Uuid
  sellerOrderId String?            @map("seller_order_id") @db.Uuid
  type          OrderEventType
  fromStatus    SellerOrderStatus? @map("from_status")
  toStatus      SellerOrderStatus? @map("to_status")
  /// Who acted: CUSTOMER, SELLER, STAFF, COURIER, PROVIDER or SYSTEM.
  actorType     String             @default("SYSTEM") @map("actor_type") @db.VarChar(20)
  note          String?            @db.VarChar(1000)
  actorId       String?            @map("actor_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor       User?        @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId, createdAt])
  @@index([sellerOrderId])
  @@index([actorId])
  @@map("order_events")
}

// ---------------------------------------------------------------------------------------
// Phase 5: payments, shipments, cash on delivery, returns, refunds and seller payables
// ---------------------------------------------------------------------------------------

/// Who processes a payment. MOCK exists for development only and is refused in production.
enum PaymentProvider {
  MOCK
  PAYMONGO
  MAYA_BUSINESS
  XENDIT
  /// Bank transfer to the marketplace's account, verified by finance from the customer's proof.
  MANUAL_BANK
  /// Cash on delivery, collected by the courier and remitted to the marketplace.
  COD

  @@map("payment_provider")
}

enum PaymentAttemptStatus {
  /// Created with the order; the provider has not been called yet.
  CREATED
  /// Waiting for the customer (or for the courier's remittance, for COD).
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED

  @@map("payment_attempt_status")
}

/// One attempt to pay an order. An order can have several (e.g. a retry after a failure);
/// at most one is PAID. Only the server's webhook processing, provider verification or
/// finance approval marks it paid, never a browser redirect.
model Payment {
  id                String               @id @default(uuid(7)) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  /// Our reference, shown to the customer and sent to the provider (e.g. "PAY-7K3M9Q2X").
  reference         String               @unique @db.VarChar(30)
  method            PaymentMethod
  provider          PaymentProvider
  status            PaymentAttemptStatus
  /// false for mock and sandbox payments: no real money moved.
  livemode          Boolean              @default(false)
  amount            Decimal              @db.Decimal(19, 4)
  currency          String               @default("PHP") @db.Char(3)
  /// What the provider (or the confirmed remittances) reported as received.
  amountReceived    Decimal              @default(0) @map("amount_received") @db.Decimal(19, 4)
  /// Refunds succeeded or in progress; never more than received (CHECK).
  refundedAmount    Decimal              @default(0) @map("refunded_amount") @db.Decimal(19, 4)
  /// The provider's checkout session or intent.
  providerReference String?              @map("provider_reference") @db.VarChar(120)
  /// The provider's payment, needed for refunds.
  providerPaymentId String?              @map("provider_payment_id") @db.VarChar(120)
  checkoutUrl       String?              @map("checkout_url") @db.VarChar(1000)
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz(3)
  paidAt            DateTime?            @map("paid_at") @db.Timestamptz(3)
  failureCode       String?              @map("failure_code") @db.VarChar(60)
  failureMessage    String?              @map("failure_message") @db.VarChar(500)
  /// Set when finance must look at it: amount mismatch, paid after the order expired, ...
  reviewReason      String?              @map("review_reason") @db.VarChar(40)
  reviewedAt        DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  reviewedById      String?              @map("reviewed_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  User?               @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currencyRef Currency            @relation("PaymentCurrency", fields: [currency], references: [code], onDelete: Restrict, onUpdate: Cascade)
  events      PaymentEvent[]
  proofs      BankTransferProof[]
  refunds     Refund[]

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([status, expiresAt])
  @@index([reviewReason])
  @@index([reviewedById])
  @@index([currency])
  @@map("payments")
}

/// Append-only history of a payment: initialised, paid, failed, proofs, refunds...
model PaymentEvent {
  id             String                @id @default(uuid(7)) @db.Uuid
  paymentId      String                @map("payment_id") @db.Uuid
  type           String                @db.VarChar(40)
  fromStatus     PaymentAttemptStatus? @map("from_status")
  toStatus       PaymentAttemptStatus? @map("to_status")
  /// Safe details only (amounts, provider ids, reasons); never card data or secrets.
  data           Json                  @default("{}")
  actorId        String?               @map("actor_id") @db.Uuid
  webhookEventId String?               @map("webhook_event_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor        User?         @relation("PaymentEventActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([paymentId, createdAt])
  @@index([actorId])
  @@index([webhookEventId])
  @@map("payment_events")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  /// Valid but not relevant (unknown event type or object).
  IGNORED
  /// Processing failed; the provider's retry (or staff) processes it again.
  FAILED

  @@map("webhook_event_status")
}

/// Every verified webhook from a payment provider or courier, stored once per provider
/// event id, so retries and duplicates are never processed twice.
model WebhookEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  /// "paymongo", "mock-payments", "mock-courier", ...
  source      String             @db.VarChar(40)
  eventId     String             @map("event_id") @db.VarChar(160)
  eventType   String             @map("event_type") @db.VarChar(80)
  livemode    Boolean            @default(false)
  status      WebhookEventStatus @default(RECEIVED)
  payload     Json
  attempts    Int                @default(0)
  error       String?            @db.VarChar(1000)
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(3)

  paymentEvents PaymentEvent[]

  @@unique([source, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Development-only state of the mock payment provider's checkout sessions.
model MockPaymentSession {
  id               String   @id @db.VarChar(60)
  paymentReference String   @map("payment_reference") @db.VarChar(30)
  amount           Decimal  @db.Decimal(19, 4)
  /// OPEN, PAID, FAILED, EXPIRED
  status           String   @db.VarChar(20)
  paymentId        String?  @map("payment_id") @db.VarChar(60)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentReference])
  @@map("mock_payment_sessions")
}

enum ProofStatus {
  SUBMITTED
  APPROVED
  REJECTED

  @@map("proof_status")
}

/// A customer's evidence of a bank transfer, reviewed by finance.
model BankTransferProof {
  id              String      @id @default(uuid(7)) @db.Uuid
  paymentId       String      @map("payment_id") @db.Uuid
  fileId          String      @unique @map("file_id") @db.Uuid
  submittedById   String      @map("submitted_by_id") @db.Uuid
  bankName        String      @map("bank_name") @db.VarChar(100)
  /// The bank's transaction reference as the customer typed it.
  referenceNumber String      @map("reference_number") @db.VarChar(60)
  amount          Decimal     @db.Decimal(19, 4)
  transferredAt   DateTime    @map("transferred_at") @db.Timestamptz(3)
  status          ProofStatus @default(SUBMITTED)
  reviewedById    String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?     @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  payment     Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  file        StoredFile @relation("PaymentProofFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy User       @relation("ProofSubmitter", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  User?      @relation("ProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([paymentId])
  @@index([status, createdAt])
  @@index([submittedById])
  @@index([reviewedById])
  @@map("bank_transfer_proofs")
}

/// Couriers. MOCK is for development; SELF means the seller arranged the delivery and
/// enters the tracking details. The others are prepared adapters, off until configured.
enum Carrier {
  MOCK
  SELF
  JNT
  LBC
  NINJA_VAN
  FLASH
  TWO_GO

  @@map("carrier")
}

enum ShipmentStatus {
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNING
  RETURNED
  CANCELLED

  @@map("shipment_status")
}

enum ShipmentDirection {
  /// Seller to customer (including a replacement).
  FORWARD
  /// Customer back to seller for a return.
  RETURN

  @@map("shipment_direction")
}

model Shipment {
  id                 String            @id @default(uuid(7)) @db.Uuid
  sellerOrderId      String            @map("seller_order_id") @db.Uuid
  returnRequestId    String?           @map("return_request_id") @db.Uuid
  direction          ShipmentDirection
  carrier            Carrier
  /// For SELF: the courier the seller used, as typed.
  carrierName        String            @map("carrier_name") @db.VarChar(80)
  serviceName        String            @map("service_name") @db.VarChar(80)
  trackingNumber     String            @map("tracking_number") @db.VarChar(60)
  providerShipmentId String?           @map("provider_shipment_id") @db.VarChar(120)
  status             ShipmentStatus
  /// Cash to collect on delivery (0 when prepaid).
  codAmount          Decimal           @default(0) @map("cod_amount") @db.Decimal(19, 4)
  waybillFileId      String?           @unique @map("waybill_file_id") @db.Uuid
  weightGrams        Int               @map("weight_grams")
  origin             Json
  destination        Json
  failedAttempts     Int               @default(0) @map("failed_attempts")
  /// false for the mock courier: no real parcel moves.
  livemode           Boolean           @default(false)
  bookedById         String?           @map("booked_by_id") @db.Uuid
  pickedUpAt         DateTime?         @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt        DateTime?         @map("delivered_at") @db.Timestamptz(3)
  lastEventAt        DateTime?         @map("last_event_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  sellerOrder   SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  returnRequest ReturnRequest?  @relation(fields: [returnRequestId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  waybillFile   StoredFile?     @relation("ShipmentWaybill", fields: [waybillFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bookedBy      User?           @relation("ShipmentBooker", fields: [bookedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events        ShipmentEvent[]
  codCollection CodCollection?

  /// Unique per real courier (partial unique index in SQL); self-arranged deliveries are typed by people.
  @@index([carrier, trackingNumber])
  @@index([sellerOrderId])
  @@index([returnRequestId])
  @@index([status, lastEventAt])
  @@index([bookedById])
  @@map("shipments")
}

model ShipmentEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  shipmentId      String         @map("shipment_id") @db.Uuid
  status          ShipmentStatus
  description     String         @db.VarChar(300)
  location        String?        @db.VarChar(120)
  occurredAt      DateTime       @map("occurred_at") @db.Timestamptz(3)
  /// CARRIER, SELLER, STAFF, CUSTOMER or SYSTEM.
  source          String         @db.VarChar(20)
  /// The carrier's id for the event, so a repeated tracking update is stored once.
  externalEventId String?        @map("external_event_id") @db.VarChar(120)
  actorId         String?        @map("actor_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor    User?    @relation("ShipmentEventActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([shipmentId, externalEventId])
  @@index([shipmentId, occurredAt])
  @@index([actorId])
  @@map("shipment_events")
}

enum CodCollectionStatus {
  /// Out for delivery or not yet shipped: cash still to be collected.
  PENDING
  /// The courier collected the cash; the marketplace has not received it yet.
  COLLECTED
  /// The courier's remittance including this parcel was confirmed: financially collected.
  REMITTED
  /// Not collected: the delivery failed and the parcel goes back to the seller.
  FAILED

  @@map("cod_collection_status")
}

/// Cash to collect for one seller order paid on delivery.
model CodCollection {
  id              String              @id @default(uuid(7)) @db.Uuid
  sellerOrderId   String              @unique @map("seller_order_id") @db.Uuid
  orderId         String              @map("order_id") @db.Uuid
  shipmentId      String?             @unique @map("shipment_id") @db.Uuid
  carrier         Carrier?
  expectedAmount  Decimal             @map("expected_amount") @db.Decimal(19, 4)
  collectedAmount Decimal?            @map("collected_amount") @db.Decimal(19, 4)
  status          CodCollectionStatus @default(PENDING)
  collectedAt     DateTime?           @map("collected_at") @db.Timestamptz(3)
  remittanceId    String?             @map("remittance_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shipment    Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  remittance  CodRemittance? @relation(fields: [remittanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, carrier])
  @@index([orderId])
  @@index([remittanceId])
  @@map("cod_collections")
}

/// A courier's (or a self-shipping seller's) payment of collected cash to the marketplace.
model CodRemittance {
  id              String   @id @default(uuid(7)) @db.Uuid
  carrier         Carrier
  /// The bank or courier reference of the remittance.
  reference       String   @db.VarChar(80)
  remittedAt      DateTime @map("remitted_at") @db.Timestamptz(3)
  /// What was actually received.
  amount          Decimal  @db.Decimal(19, 4)
  /// Sum of the collections it covers.
  expectedAmount  Decimal  @map("expected_amount") @db.Decimal(19, 4)
  /// Explanation required when amount differs from expected_amount.
  discrepancyNote String?  @map("discrepancy_note") @db.VarChar(1000)
  recordedById    String   @map("recorded_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recordedBy  User            @relation("RemittanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  collections CodCollection[]

  @@unique([carrier, reference])
  @@index([remittedAt])
  @@index([recordedById])
  @@map("cod_remittances")
}

enum CancellationRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("cancellation_request_status")
}

/// A customer's request to cancel a seller order the seller already started.
model CancellationRequest {
  id            String                    @id @default(uuid(7)) @db.Uuid
  sellerOrderId String                    @map("seller_order_id") @db.Uuid
  requestedById String                    @map("requested_by_id") @db.Uuid
  reason        String                    @db.VarChar(500)
  status        CancellationRequestStatus @default(REQUESTED)
  respondedById String?                   @map("responded_by_id") @db.Uuid
  response      String?                   @db.VarChar(500)
  respondedAt   DateTime?                 @map("responded_at") @db.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requestedBy User        @relation("CancellationRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  respondedBy User?       @relation("CancellationResponder", fields: [respondedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sellerOrderId, status])
  @@index([requestedById])
  @@index([respondedById])
  @@map("cancellation_requests")
}

enum NoteVisibility {
  /// Seen by the customer, the seller and staff.
  CUSTOMER
  /// Seen by the seller and staff.
  SELLER
  /// Seen by marketplace staff only.
  STAFF

  @@map("note_visibility")
}

model OrderNote {
  id            String         @id @default(uuid(7)) @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  sellerOrderId String?        @map("seller_order_id") @db.Uuid
  authorId      String         @map("author_id") @db.Uuid
  /// CUSTOMER, SELLER or STAFF.
  authorType    String         @map("author_type") @db.VarChar(20)
  visibility    NoteVisibility
  body          String         @db.VarChar(2000)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author      User         @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId, createdAt])
  @@index([sellerOrderId])
  @@index([authorId])
  @@map("order_notes")
}

enum ReturnStatus {
  /// Waiting for the seller (until seller_deadline).
  REQUESTED
  /// Accepted; waiting for the customer to send the item back (or for the refund).
  APPROVED
  /// The seller refused; the customer may escalate.
  REJECTED
  /// The customer asked the marketplace to decide.
  ESCALATED
  /// The customer sent the item back.
  RETURN_SHIPPED
  /// The seller received the item back.
  RECEIVED
  /// Refund or replacement done.
  RESOLVED
  /// Closed without a refund (rejection accepted, or staff decided against it).
  CLOSED
  /// The customer withdrew it.
  CANCELLED

  @@map("return_status")
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  MISSING_PARTS
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER

  @@map("return_reason")
}

enum ReturnResolution {
  FULL_REFUND
  PARTIAL_REFUND
  REPLACEMENT
  REJECTED

  @@map("return_resolution")
}

model ReturnRequest {
  id                     String            @id @default(uuid(7)) @db.Uuid
  /// e.g. "RT-MP2611250001AB-1-1"
  number                 String            @unique @db.VarChar(40)
  orderId                String            @map("order_id") @db.Uuid
  sellerOrderId          String            @map("seller_order_id") @db.Uuid
  sellerId               String            @map("seller_id") @db.Uuid
  customerId             String            @map("customer_id") @db.Uuid
  status                 ReturnStatus
  reason                 ReturnReason
  description            String            @db.VarChar(2000)
  /// What the customer asked for: FULL_REFUND or REPLACEMENT.
  requestedResolution    ReturnResolution  @map("requested_resolution")
  /// What was decided (by the seller, or by staff after escalation).
  resolution             ReturnResolution?
  /// Customer money to give back for a refund resolution (items only unless staff add shipping).
  refundAmount           Decimal?          @map("refund_amount") @db.Decimal(19, 4)
  /// Whether the item must be sent back before the refund or replacement.
  requiresReturnShipment Boolean           @default(true) @map("requires_return_shipment")
  sellerResponse         String?           @map("seller_response") @db.VarChar(1000)
  sellerRespondedAt      DateTime?         @map("seller_responded_at") @db.Timestamptz(3)
  sellerDeadline         DateTime          @map("seller_deadline") @db.Timestamptz(3)
  escalationNote         String?           @map("escalation_note") @db.VarChar(1000)
  escalatedAt            DateTime?         @map("escalated_at") @db.Timestamptz(3)
  staffDecisionNote      String?           @map("staff_decision_note") @db.VarChar(1000)
  decidedById            String?           @map("decided_by_id") @db.Uuid
  receivedAt             DateTime?         @map("received_at") @db.Timestamptz(3)
  /// Whether received items went back into sellable stock.
  restocked              Boolean?
  resolvedAt             DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerOrder SellerOrder   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seller      Seller        @relation("SellerReturns", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer    User          @relation("ReturnCustomer", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedBy   User?         @relation("ReturnDecider", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items       ReturnItem[]
  images      ReturnImage[]
  shipments   Shipment[]
  refunds     Refund[]

  @@index([sellerOrderId])
  @@index([orderId])
  @@index([sellerId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([status, sellerDeadline])
  @@index([decidedById])
  @@map("return_requests")
}

model ReturnItem {
  id              String @id @default(uuid(7)) @db.Uuid
  returnRequestId String @map("return_request_id") @db.Uuid
  orderItemId     String @map("order_item_id") @db.Uuid
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnImage {
  id              String @id @default(uuid(7)) @db.Uuid
  returnRequestId String @map("return_request_id") @db.Uuid
  fileId          String @unique @map("file_id") @db.Uuid
  position        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file          StoredFile    @relation("ReturnImageFile", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([returnRequestId])
  @@map("return_images")
}

enum RefundStatus {
  /// Created; the provider call (or manual payout) has not completed.
  PROCESSING
  /// Manual refund (bank transfer, cash on delivery) waiting for finance to pay it out.
  AWAITING_PAYOUT
  SUCCEEDED
  FAILED

  @@map("refund_status")
}

enum RefundReason {
  CANCELLATION
  RETURN
  /// Paid after the order had already expired.
  LATE_PAYMENT
  DUPLICATE_PAYMENT
  GOODWILL
  OTHER

  @@map("refund_reason")
}

/// Money given back to a customer. Each refund belongs to one payment and one seller order,
/// splits into items, shipping and charges, and records what it costs the seller.
model Refund {
  id                 String       @id @default(uuid(7)) @db.Uuid
  /// e.g. "RF-7K3M9Q2X"
  reference          String       @unique @db.VarChar(30)
  orderId            String       @map("order_id") @db.Uuid
  sellerOrderId      String?      @map("seller_order_id") @db.Uuid
  paymentId          String       @map("payment_id") @db.Uuid
  returnRequestId    String?      @map("return_request_id") @db.Uuid
  reason             RefundReason
  /// FULL (everything still refundable on the seller order) or PARTIAL.
  kind               String       @db.VarChar(10)
  status             RefundStatus
  amount             Decimal      @db.Decimal(19, 4)
  itemsAmount        Decimal      @map("items_amount") @db.Decimal(19, 4)
  shippingAmount     Decimal      @map("shipping_amount") @db.Decimal(19, 4)
  chargesAmount      Decimal      @map("charges_amount") @db.Decimal(19, 4)
  /// Taken back from the seller's payable (their share of the refunded items, and shipping
  /// they were credited for).
  sellerDebit        Decimal      @map("seller_debit") @db.Decimal(19, 4)
  /// Commission the marketplace gives back to the seller for the refunded items.
  commissionReversal Decimal      @map("commission_reversal") @db.Decimal(19, 4)
  /// Through the provider (ORIGINAL) or paid out by finance (MANUAL).
  method             String       @db.VarChar(10)
  /// Stops the same refund being created twice (e.g. a double-clicked button).
  idempotencyKey     String       @unique @map("idempotency_key") @db.VarChar(120)
  providerRefundId   String?      @map("provider_refund_id") @db.VarChar(120)
  payoutReference    String?      @map("payout_reference") @db.VarChar(80)
  failureMessage     String?      @map("failure_message") @db.VarChar(500)
  note               String?      @db.VarChar(1000)
  livemode           Boolean      @default(false)
  requestedById      String?      @map("requested_by_id") @db.Uuid
  processedById      String?      @map("processed_by_id") @db.Uuid
  succeededAt        DateTime?    @map("succeeded_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerOrder   SellerOrder?        @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment       Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  returnRequest ReturnRequest?      @relation(fields: [returnRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedBy   User?               @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  processedBy   User?               @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ledgerEntries SellerLedgerEntry[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([paymentId])
  @@index([returnRequestId])
  @@index([status, createdAt])
  @@index([requestedById])
  @@index([processedById])
  @@map("refunds")
}

enum SellerLedgerType {
  /// The seller's earning on a paid (or remitted) seller order: items minus their discount.
  ORDER_EARNING
  /// Marketplace commission (negative).
  COMMISSION
  /// Shipping fee paid by the customer, credited to a seller who shipped it themselves.
  SHIPPING_CREDIT
  /// A refund's cost to the seller (negative).
  REFUND
  /// Commission given back on refunded items (positive).
  COMMISSION_REVERSAL
  ADJUSTMENT

  @@map("seller_ledger_type")
}

/// Append-only record of what the marketplace owes each seller (payouts in the finance
/// phase). The balance is the sum of amounts.
model SellerLedgerEntry {
  id            String           @id @default(uuid(7)) @db.Uuid
  sellerId      String           @map("seller_id") @db.Uuid
  sellerOrderId String?          @map("seller_order_id") @db.Uuid
  refundId      String?          @map("refund_id") @db.Uuid
  type          SellerLedgerType
  /// Positive: owed to the seller; negative: owed by the seller.
  amount        Decimal          @db.Decimal(19, 4)
  description   String           @db.VarChar(300)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  seller      Seller       @relation("SellerLedger", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refund      Refund?      @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sellerId, createdAt])
  @@index([sellerOrderId])
  @@index([refundId])
  @@map("seller_ledger_entries")
}
