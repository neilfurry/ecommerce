{
  "name": "@marketplace/api",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace REST API (NestJS modular monolith)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@marketplace/config": "workspace:*",
    "@marketplace/database": "workspace:*",
    "@marketplace/shared-types": "workspace:*",
    "@marketplace/validation": "workspace:*",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "multer": "2.5.0",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3"
  }
