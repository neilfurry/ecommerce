{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-vendor e-commerce marketplace for the Philippine market",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "build": "pnpm run build:packages && pnpm --filter \"./apps/**\" run build",
    "dev": "pnpm run build:packages && pnpm --parallel --filter \"./apps/**\" --filter \"./packages/**\" run dev",
    "dev:api": "pnpm run build:packages && pnpm --filter @marketplace/api run dev",
    "dev:worker": "pnpm run build:packages && pnpm --filter @marketplace/worker run dev",
    "dev:storefront": "pnpm --filter @marketplace/storefront run dev",
    "dev:seller": "pnpm --filter @marketplace/seller-portal run dev",
    "dev:admin": "pnpm --filter @marketplace/admin-portal run dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @marketplace/api run prisma:generate",
    "db:migrate": "pnpm --filter @marketplace/api run prisma:migrate:dev",
    "db:deploy": "pnpm --filter @marketplace/api run prisma:migrate:deploy",
    "db:seed": "pnpm --filter @marketplace/api run prisma:seed",
    "db:reset": "pnpm --filter @marketplace/api run prisma:reset",
    "db:studio": "pnpm --filter @marketplace/api run prisma:studio",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build:packages && pnpm -r run test",
    "test:unit": "pnpm run build:packages && pnpm -r run test:unit",
    "test:e2e:api": "pnpm --filter @marketplace/api run test:e2e",
    "test:e2e:ui": "playwright test",
    "test:all": "pnpm run test && pnpm run test:e2e:api && pnpm run test:integration:worker && pnpm run test:e2e:ui",
    "test:integration:worker": "pnpm --filter @marketplace/worker run test:integration",
    "db:backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-db.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
