# -----------------------------------------------------------------------------
# Marketplace local development environment
# Copy this file to ".env" in the repository root:
#   PowerShell:  Copy-Item .env.example .env
# Every app (API, worker, frontends) and docker compose read the root .env.
# Never commit .env. Production secrets come from the deployment environment.
# -----------------------------------------------------------------------------

# NODE_ENV is intentionally not set here: the API and worker default to
# "development", and Vite would otherwise build development bundles.
# Set NODE_ENV=production in the deployment environment.

# ---- API ---------------------------------------------------------------------
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Set to true (or a hop count) only when running behind a trusted reverse proxy.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Global rate limit: max requests per client IP per window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
# Serve Swagger UI at /api/docs (disable in production unless protected).
SWAGGER_ENABLED=true

# ---- PostgreSQL (docker compose service "postgres") --------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_dev_password
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://marketplace:marketplace_dev_password@localhost:5432/marketplace?schema=public

# ---- Redis (docker compose service "redis") ----------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- S3-compatible object storage (docker compose service "minio") ----------
# MinIO stopped publishing official images in Oct 2025; Chainguard maintains a
# free build. Any S3-compatible image works here.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_ROOT_USER=marketplace
MINIO_ROOT_PASSWORD=marketplace_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=marketplace
S3_SECRET_ACCESS_KEY=marketplace_dev_secret
S3_BUCKET=marketplace-dev
# MinIO requires path-style URLs (http://host/bucket/key).
S3_FORCE_PATH_STYLE=true
# Create the bucket on API start-up if it does not exist (development only).
S3_AUTO_CREATE_BUCKET=true

# ---- Background worker -------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=15

# ---- Frontends (Vite exposes only VITE_* variables to the browser) ----------
# Path or absolute URL of the API as seen by the browser.
VITE_API_BASE_URL=/api
# Where the Vite dev server proxies /api requests to.
VITE_API_PROXY_TARGET=http://localhost:3000
